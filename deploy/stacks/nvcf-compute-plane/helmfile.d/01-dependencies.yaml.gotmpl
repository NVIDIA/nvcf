# NVCF Compute Plane Releases
#
# Optional releases, installed once per GPU cluster:
#   kai-scheduler:           addons.kaiScheduler.enabled (required by grove/dynamo)
#   nvcf-kai-topology:       KAI Topology CRs
#                            (topologyAwareScheduling + kaiScheduler)
#   grove-operator:          topology-aware scheduling (addons.groveOperator.enabled)
#   nvcf-grove-topology:     Grove ClusterTopologyBinding CRs
#                            (topologyAwareScheduling + groveOperator; needs KAI Topology)
#   dynamo-operator:         Dynamo inference framework scheduling (addons.dynamoOperator.enabled)
#
# CLUSTER_NAME is required and scopes the registration values handoff file.
# Run `make register-cluster CLUSTER_NAME=<name>` before `make install`.

environments:
  default:
    values:
      - ../environments/base.yaml
      - ../environments/{{ requiredEnv "HELMFILE_ENV" }}.yaml

---

repositories:
  - name: kai-scheduler
    url: ghcr.io/kai-scheduler/kai-scheduler
    oci: true
  - name: nvidia-ai-dynamo-grove
    url: ghcr.io/ai-dynamo/grove
    oci: true
  - name: nvidia-ai-dynamo
    url: https://helm.ngc.nvidia.com/nvidia/ai-dynamo

helmDefaults:
  createNamespace: true
  devel: true
  timeout: 900
  wait: true
  waitForJobs: true
  diffArgs:
    - "--dry-run=server"

{{- /*
     Preferred hostname anti-affinity for one KAI operand, keyed on the "app" label
     the KAI operator sets to the Deployment name. The operator intends to add this
     term itself, but its affinity merge returns early when neither the global nor
     the per-service affinity is set, so both replicas can land on one node
     (upstream kai-scheduler PR #2529). Preferred, not required: a required term
     plus the operands' RollingUpdate maxSurge would leave a surge Pod Pending on a
     pool with no spare node.
*/}}
{{- define "kaiScheduler.spreadReplicas" -}}
affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          topologyKey: kubernetes.io/hostname
          labelSelector:
            matchLabels:
              app: {{ . }}
{{- end }}

releases:

  - name: kai-scheduler
    # Required by grove-operator and dynamo-operator. Release name and namespace
    # must be "kai-scheduler" per KAI installation requirements.
    # Enable per-environment: addons.kaiScheduler.enabled: true
    # Per-component resources can be overridden under addons.kaiScheduler.<component>.resources,
    # and the replica count under addons.kaiScheduler.replicaCount (default 2; set 1
    # on single-node clusters).
    condition: addons.kaiScheduler.enabled
    chart: kai-scheduler/kai-scheduler
    version: v0.18.6
    namespace: kai-scheduler
    values:
      - ../global.yaml.gotmpl
      - {{- $kai := dig "kaiScheduler" dict .Values.addons }}
        {{- $opRes := dig "operator" "resources" dict $kai }}
        {{- $opReq := dig "requests" dict $opRes }}
        {{- $opLim := dig "limits" dict $opRes }}
        {{- $pgRes := dig "podgrouper" "resources" dict $kai }}
        {{- $pgReq := dig "requests" dict $pgRes }}
        {{- $pgLim := dig "limits" dict $pgRes }}
        {{- $pgcRes := dig "podgroupcontroller" "resources" dict $kai }}
        {{- $pgcReq := dig "requests" dict $pgcRes }}
        {{- $pgcLim := dig "limits" dict $pgcRes }}
        {{- $bdRes := dig "binder" "resources" dict $kai }}
        {{- $bdReq := dig "requests" dict $bdRes }}
        {{- $bdLim := dig "limits" dict $bdRes }}
        {{- $schRes := dig "scheduler" "resources" dict $kai }}
        {{- $schReq := dig "requests" dict $schRes }}
        {{- $schLim := dig "limits" dict $schRes }}
        {{- $qcRes := dig "queuecontroller" "resources" dict $kai }}
        {{- $qcReq := dig "requests" dict $qcRes }}
        {{- $qcLim := dig "limits" dict $qcRes }}
        {{- $adRes := dig "admission" "resources" dict $kai }}
        {{- $adReq := dig "requests" dict $adRes }}
        {{- $adLim := dig "limits" dict $adRes }}
        {{- $nsaRes := dig "nodescaleadjuster" "resources" dict $kai }}
        {{- $nsaReq := dig "requests" dict $nsaRes }}
        {{- $nsaLim := dig "limits" dict $nsaRes }}
        {{- $npeRes := dig "numaPlacementExporter" "resources" dict $kai }}
        {{- $npeReq := dig "requests" dict $npeRes }}
        {{- $npeLim := dig "limits" dict $npeRes }}
        {{- $replicas := dig "replicaCount" 2 $kai }}
        global:
          # From v0.18 the chart enables GPU sharing (NonMemoryEnforced) when
          # neither gpuSharingMode nor the removed gpuSharing is set. NVCF
          # workloads request whole GPUs, so keep sharing off.
          gpuSharingMode: Disabled
          securityContext:
            runAsUser: 10000
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
          {{- if .Values.global.nodeSelector.enabled }}
          nodeSelector:
            {{ .Values.global.nodeSelector.key | quote }}: {{ .Values.global.nodeSelector.value | quote }}
          {{- end }}
          {{- if .Values.global.imagePullSecrets }}
          imagePullSecrets:
          {{- toYaml .Values.global.imagePullSecrets | nindent 12 }}
          {{- end }}
          {{- if not (empty .Values.global.tolerations) }}
          tolerations:
          {{- toYaml .Values.global.tolerations | nindent 12 }}
          {{- end }}

        # Image names stay at chart defaults (ghcr.io/kai-scheduler/kai-scheduler/*).
        operator:
          # KAI's global replica count, not just the operator's: it also feeds
          # Config.spec.global.replicaCount, which sizes every operand (scheduler,
          # binder, admission, pod-grouper, podgroup-controller, queue-controller).
          # Above 1, the operator and each operand run leader election (one active,
          # one hot standby), and the scheduler, pod-grouper and admission get a
          # PodDisruptionBudget. On a single-node cluster that PDB can block a node
          # drain, so set addons.kaiScheduler.replicaCount: 1 there.
          replicaCount: {{ $replicas }}
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $opReq }}
              memory: {{ dig "memory" "256Mi" $opReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $opLim }}
              memory: {{ dig "memory" "1Gi" $opLim }}

        podgrouper:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $pgReq }}
              memory: {{ dig "memory" "512Mi" $pgReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $pgLim }}
              memory: {{ dig "memory" "4Gi" $pgLim }}
          {{- include "kaiScheduler.spreadReplicas" "pod-grouper" | nindent 10 }}

        podgroupcontroller:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $pgcReq }}
              memory: {{ dig "memory" "256Mi" $pgcReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $pgcLim }}
              memory: {{ dig "memory" "1Gi" $pgcLim }}
          {{- include "kaiScheduler.spreadReplicas" "podgroup-controller" | nindent 10 }}

        binder:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $bdReq }}
              memory: {{ dig "memory" "2Gi" $bdReq }}
            limits:
              cpu: {{ dig "cpu" "4000m" $bdLim }}
              memory: {{ dig "memory" "4Gi" $bdLim }}
          {{- include "kaiScheduler.spreadReplicas" "binder" | nindent 10 }}

        scheduler:
          {{- if dig "dynamoOperator" "enabled" false .Values.addons }}
          # Grove's KAI backend owns PodGroup termination for Dynamo workloads.
          # Disable KAI's independent stale PodGroup eviction, as the Dynamo 1.5+
          # upgrade guide requires.
          args:
            default-staleness-grace-period: "-1s"
          {{- end }}
          placementStrategy: binpack
          plugins:
            nodeplacement:
              arguments:
                gpu: binpack
                cpu: spread
          actions:
            preempt:
              enabled: false
            consolidation:
              enabled: false
            # reclaim is the last KAI action that evicts running Pods. NVCA requires
            # unlimited queue quotas, so quota-based reclaim never applies. KAI's
            # default allow-consolidating-reclaim still lets reclaim evict another
            # queue's running Pods whenever it can re-place them on other nodes,
            # because moved Pods are not counted against the fair-share check.
            # Dynamo creates its own queue tree next to NVCA's default-queue, so
            # this relocates running inference workers to make room for another
            # workload's pending gang. With reclaim off, a pending gang waits for
            # free capacity instead of displacing running workloads.
            reclaim:
              enabled: false
          resources:
            requests:
              cpu: {{ dig "cpu" "500m" $schReq }}
              memory: {{ dig "memory" "3Gi" $schReq }}
            limits:
              cpu: {{ dig "cpu" "2000m" $schLim }}
              memory: {{ dig "memory" "6Gi" $schLim }}
          {{- include "kaiScheduler.spreadReplicas" "kai-scheduler-default" | nindent 10 }}

        queuecontroller:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $qcReq }}
              memory: {{ dig "memory" "256Mi" $qcReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $qcLim }}
              memory: {{ dig "memory" "1Gi" $qcLim }}
          {{- include "kaiScheduler.spreadReplicas" "queue-controller" | nindent 10 }}

        admission:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $adReq }}
              memory: {{ dig "memory" "256Mi" $adReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $adLim }}
              memory: {{ dig "memory" "1Gi" $adLim }}
          {{- include "kaiScheduler.spreadReplicas" "admission" | nindent 10 }}

        nodescaleadjuster:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $nsaReq }}
              memory: {{ dig "memory" "256Mi" $nsaReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $nsaLim }}
              memory: {{ dig "memory" "1Gi" $nsaLim }}

        numaPlacementExporter:
          resources:
            requests:
              cpu: {{ dig "cpu" "50m" $npeReq }}
              memory: {{ dig "memory" "64Mi" $npeReq }}
            limits:
              cpu: {{ dig "cpu" "1000m" $npeLim }}
              memory: {{ dig "memory" "1Gi" $npeLim }}

        # KAI's bundled Prometheus only feeds time-aware fairness (usage-window
        # fair share), which this stack does not use: it runs plain proportion
        # fairness with preempt, consolidation and reclaim disabled. Matches the
        # chart default; pinned so an upstream default flip cannot quietly stand
        # up a second Prometheus in the cluster.
        prometheus:
          enabled: false

        defaultQueue:
          createDefaultQueue: true
          parentName: default-parent-queue
          childName: default-queue
          parentResources:
            cpu:
              quota: -1
              limit: -1
              overQuotaWeight: 1
            gpu:
              quota: -1
              limit: -1
              overQuotaWeight: 1
            memory:
              quota: -1
              limit: -1
              overQuotaWeight: 1
          childResources:
            cpu:
              quota: -1
              limit: -1
              overQuotaWeight: 1
            gpu:
              quota: -1
              limit: -1
              overQuotaWeight: 1
            memory:
              quota: -1
              limit: -1
              overQuotaWeight: 1
    labels:
      release-group: workers
    wait: true
    waitForJobs: true

  - name: nvcf-kai-topology
    # Cluster-scoped KAI Scheduler Topology resources (optional; disabled by
    # default). Workloads opt in through the `kai.scheduler/topology`
    # annotation so KAI places every replica of a StatefulSet inside a single
    # clique instead of binding pods one at a time.
    #
    # Installed when addons.topologyAwareScheduling.enabled and
    # addons.kaiScheduler.enabled are both true. Configure the Topology list
    # under addons.topologyAwareScheduling.topologies.
    #
    # Requires the kai-scheduler release (and KAI v0.12.0 or later) for the
    # native `kai.scheduler/v1alpha1` Topology CRD.
    #
    # Resources are cluster-scoped; the release lives in the nvca-operator
    # namespace so lifecycle stays with NVCA-owned resources.
    {{- $topoEnabled := dig "topologyAwareScheduling" "enabled" false .Values.addons }}
    {{- $kaiEnabled := dig "kaiScheduler" "enabled" false .Values.addons }}
    {{- if and $topoEnabled (not $kaiEnabled) }}
    {{- fail "addons.topologyAwareScheduling.enabled requires addons.kaiScheduler.enabled" }}
    {{- end }}
    installed: {{ and $topoEnabled $kaiEnabled }}
    chart: ../charts/nvcf-cluster-topology
    namespace: nvca-operator
    needs:
      - kai-scheduler/kai-scheduler
    values:
      - topologies:
        {{- toYaml (dig "topologyAwareScheduling" "topologies" list .Values.addons) | nindent 10 }}
        kaiScheduler:
          enabled: true
        groveOperator:
          enabled: false
    labels:
      release-group: workers
    wait: true
    waitForJobs: true

  - name: grove-operator
    # Topology-aware scheduling operator (optional; disabled by default).
    # Enable per-environment: addons.groveOperator.enabled: true
    condition: addons.groveOperator.enabled
    # Minimum v0.1.0-alpha.12-rc1: dynamo-operator 1.4.x's compatibility
    # matrix requires Grove >= v0.1.0-alpha.12-rc1 for the ClusterTopologyBinding
    # API (NVIDIA/nvcf#1269). Earlier charts also have no nodeSelector support
    # and silently drop the nodeSelector set below, letting the operator
    # schedule onto any node - including one whose architecture its image
    # does not support. dynamo-platform 1.6.x pins Grove v0.1.0-alpha.14 as
    # its bundled subchart, so Dynamo 1.6 needs at least that.
    chart: nvidia-ai-dynamo-grove/grove-charts
    version: v0.1.0-alpha.16
    namespace: grove-system
    needs:
      - kai-scheduler/kai-scheduler
    values:
      - ../global.yaml.gotmpl
      - replicaCount: 1
        image:
          repository: ghcr.io/ai-dynamo/grove/grove-operator
          tag: v0.1.0-alpha.16
        # Protects the operator from preemption and eviction. The chart creates
        # this PriorityClass itself (999999550 sits above every normal workload
        # and just below system-cluster-critical); Grove cannot reference an
        # existing class, so a built-in name must not be used here.
        priorityClass:
          enabled: true
          name: grove-operator-priority-critical
          value: 999999550
        resources:
          limits:
            memory: 1Gi
          requests:
            cpu: 50m
            memory: 128Mi
        {{- if .Values.global.nodeSelector.enabled }}
        nodeSelector:
          {{ .Values.global.nodeSelector.key | quote }}: {{ .Values.global.nodeSelector.value | quote }}
        {{- end }}
        {{- if not (empty .Values.global.tolerations) }}
        tolerations:
        {{- toYaml .Values.global.tolerations | nindent 8 }}
        {{- end }}
        podAnnotations: {}
        config:
          leaderElection:
            enabled: true
            leaseDuration: 15s
            renewDeadline: 10s
            retryPeriod: 2s
            resourceName: grove-operator-leader-election
          logLevel: info
          logFormat: json
          controllers:
            podCliqueSet:
              concurrentSyncs: 3
            podClique:
              concurrentSyncs: 3
            podCliqueScalingGroup:
              concurrentSyncs: 3
          {{- if dig "topologyAwareScheduling" "enabled" false .Values.addons }}
          topologyAwareScheduling:
            enabled: true
          {{- end }}
          {{- with .Values.addons.groveOperator.network }}
          network:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          server:
            webhooks:
              port: 9443
              certProvisionMode: auto
              secretName: grove-webhook-server-cert
            healthProbes:
              enable: true
              port: 9444
            metrics:
              port: 9445
        # Leave the webhook server secret to the operator's own auto-provision
        # flow so Helm upgrades do not overwrite it.
        webhookServerSecret:
          enabled: false
        # Init container that SSAs Grove CRDs on every pod startup. Helm does not
        # upgrade CRDs on `helm upgrade`, so this covers both install and upgrade.
        crdInstaller:
          enabled: true
    labels:
      release-group: workers
    wait: true
    waitForJobs: true

  - name: nvcf-grove-topology
    # Cluster-scoped Grove ClusterTopologyBinding resources (optional).
    # Installed when addons.topologyAwareScheduling.enabled and
    # addons.groveOperator.enabled are both true. Bindings are derived from
    # addons.topologyAwareScheduling.topologies and reference the KAI Topology
    # CRs created by nvcf-kai-topology.
    #
    # Waits on grove-operator (ClusterTopologyBinding CRD) and
    # nvcf-kai-topology (Topology CRs referenced by topologyReference).
    {{- $topoEnabled := dig "topologyAwareScheduling" "enabled" false .Values.addons }}
    {{- $groveEnabled := dig "groveOperator" "enabled" false .Values.addons }}
    installed: {{ and $topoEnabled $groveEnabled }}
    chart: ../charts/nvcf-cluster-topology
    namespace: nvca-operator
    needs:
      - grove-system/grove-operator
      - nvca-operator/nvcf-kai-topology
    values:
      - topologies:
        {{- toYaml (dig "topologyAwareScheduling" "topologies" list .Values.addons) | nindent 10 }}
        kaiScheduler:
          enabled: false
        groveOperator:
          enabled: true
    labels:
      release-group: workers
    wait: true
    waitForJobs: true

  - name: dynamo-operator
    # Dynamo inference framework scheduling operator (optional; disabled by default).
    # Enable per-environment: addons.dynamoOperator.enabled: true
    # Minimum 1.4.0: earlier releases speak the legacy Grove ClusterTopology
    # API, which no longer exists once Grove is on v0.1.0-alpha.12-rc1+
    # (NVIDIA/nvcf#1269). From 1.5 the DynamoCheckpoint CRD is gone, so NVCA
    # must not list it as an extra type (see 02-nvca.yaml.gotmpl), and KAI's
    # stale PodGroup eviction is turned off (see the kai-scheduler release).
    condition: addons.dynamoOperator.enabled
    chart: nvidia-ai-dynamo/dynamo-platform
    version: 1.6.2
    namespace: dynamo-system
    needs:
      - grove-system/grove-operator
    values:
      - ../global.yaml.gotmpl
      - {{- $dynamo := dig "dynamoOperator" dict .Values.addons }}
        {{- $natsImage := dig "nats" "image" dict $dynamo }}
        dynamo-operator:
          controllerManager:
            manager:
              image:
                repository: nvcr.io/nvidia/ai-dynamo/kubernetes-operator
            resources:
              limits:
                memory: 2Gi
              requests:
                cpu: 512m
                memory: 1Gi
            replicas: 1
            {{- if .Values.global.nodeSelector.enabled }}
            affinity:
              nodeAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  nodeSelectorTerms:
                  - matchExpressions:
                    - key: {{ .Values.global.nodeSelector.key | quote }}
                      operator: In
                      values:
                      - {{ .Values.global.nodeSelector.value | quote }}
            {{- end }}
            {{- if not (empty .Values.global.tolerations) }}
            tolerations:
            {{- toYaml .Values.global.tolerations | nindent 12 }}
            {{- end }}
          upgradeCRD: true
          webhook:
            failurePolicy: Fail
            certManager:
              enabled: false
          namespaceRestriction:
            enabled: false
        nats:
          container:
            image:
              registry: {{ dig "registry" "docker.io" $natsImage | quote }}
              repository: {{ dig "repository" "library/nats" $natsImage | quote }}
              tag: {{ dig "tag" "2.10.21-alpine" $natsImage | quote }}
          # Keep the bundled Dynamo NATS reloader aligned with the NVCF NATS
          # chart default. The release inventory merger rejects different
          # versions of the same image.
          reloader:
            image:
              registry: docker.io
              tag: "0.25.0"
          # JetStream config lives under nats.config.jetstream in the NATS
          # sub-chart, which silently ignores the same keys at any other path.
          config:
            jetstream:
              enabled: true
              fileStore:
                enabled: true
                pvc:
                  enabled: true
          {{- $ns := .Values.global.nodeSelector | default dict -}}
          {{- $tol := .Values.global.tolerations | default list -}}
          {{- $nsKey := dig "key" nil $ns -}}
          {{- $nsValue := dig "value" nil $ns -}}
          {{- /* Presence-based, so a configured `false` or `0` still counts as set. */ -}}
          {{- $nsSet := and (not (kindIs "invalid" $nsKey)) (ne (toString $nsKey) "") -}}
          {{- $nsSet = and $nsSet (not (kindIs "invalid" $nsValue)) (ne (toString $nsValue) "") -}}
          {{- $nsOn := and (dig "enabled" false $ns) $nsSet -}}
          {{- if or $nsOn (not (empty $tol)) }}
          podTemplate:
            merge:
              spec:
                # Pin NATS pods to control-plane / monitoring nodes; required for
                # JetStream PVC attachment in some clusters (e.g. OCI). Override
                # this nodeSelector per environment when no `monitoring` node
                # group exists (e.g. local k3d).
                {{- if $nsOn }}
                nodeSelector:
                  {{ $nsKey | quote }}: {{ $nsValue | quote }}
                {{- end }}
                {{- with $tol }}
                tolerations:
                {{- toYaml . | nindent 16 }}
                {{- end }}
        {{- end }}
        global:
          nats:
            install: true
          etcd:
            enabled: false
            install: false
          grove:
            enabled: true
            install: false
          kai-scheduler:
            # NVCA injects KAI scheduler config into workload pod specs; the
            # operator chart itself does not need to wire to KAI.
            enabled: false
            install: false
        metricsService:
          enabled: true
    labels:
      release-group: workers
    wait: true
    waitForJobs: true
