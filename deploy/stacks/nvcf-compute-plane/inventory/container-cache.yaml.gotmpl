# Inventory profile for the separately installed, optional container cache.
# Kept outside helmfile.d so ordinary compute-plane operations do not install it.
environments:
  default:
    values:
      - ../environments/base.yaml
      - containerCache:
          enabled: false
          monitoring: false

---

repositories:
  - name: nvcf
    url: {{ .Values.global.helm.sources.registry }}/{{ .Values.global.helm.sources.repository }}
    oci: true

releases:
  - name: nvcf-container-cache
    namespace: container-caching
    condition: containerCache.enabled
    chart: nvcf/nvcf-container-cache
    version: 0.30.11
    values:
      - monitoring:
          enabled: {{ .Values.containerCache.monitoring }}
