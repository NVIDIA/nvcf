environments:
  default:
    values:
      - ../environments/base.yaml
      - ../environments/{{ requiredEnv "HELMFILE_ENV" }}.yaml

---

{{- $helmSourceURL := dig "global" "helm" "sources" "url" "" .Values }}
{{- $helmSourceURLIsLoopbackHTTP := or (hasPrefix "http://127.0.0.1:" $helmSourceURL) (hasPrefix "http://localhost:" $helmSourceURL) }}
{{- if and $helmSourceURL (not (or (hasPrefix "https://" $helmSourceURL) $helmSourceURLIsLoopbackHTTP)) }}
{{- fail "global.helm.sources.url must use https:// unless it points at local loopback HTTP for tests" }}
{{- end }}
{{- $controlPlaneOwnerRenderer := "../renderers/control-plane-owner-label.sh" }}
{{- $controlPlaneOwner := env "NVCF_CONTROL_PLANE_OWNER" | default "default" }}
{{- $alphaNamedControlPlane := env "NVCF_ALPHA_NAMED_CONTROL_PLANE" | default "false" }}
{{- if or (eq $controlPlaneOwner "shared") (gt (len $controlPlaneOwner) 30) (not (regexMatch "^(default|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$" $controlPlaneOwner)) }}
{{- fail (printf "NVCF_CONTROL_PLANE_OWNER must be default or a lowercase DNS label up to 30 characters other than shared, got %q" $controlPlaneOwner) }}
{{- end }}
{{- if not (has $alphaNamedControlPlane (list "true" "false")) }}
{{- fail (printf "NVCF_ALPHA_NAMED_CONTROL_PLANE must be true or false, got %q" $alphaNamedControlPlane) }}
{{- end }}
{{- if and (ne $controlPlaneOwner "default") (ne $alphaNamedControlPlane "true") }}
{{- fail "NVCF_ALPHA_NAMED_CONTROL_PLANE=true is required when NVCF_CONTROL_PLANE_OWNER is a named control plane" }}
{{- end }}
{{- $controlPlaneNamespacePrefix := "" }}
{{- if and (ne $controlPlaneOwner "default") (eq $controlPlaneNamespacePrefix "") }}
{{- fail "named control planes are not enabled yet because namespace derivation is not wired; refusing to render named objects into legacy namespaces" }}
{{- end }}
{{- $apiKeysNamespace := printf "%sapi-keys" $controlPlaneNamespacePrefix }}
{{- $essNamespace := printf "%sess" $controlPlaneNamespacePrefix }}
{{- $natsNamespace := printf "%snats-system" $controlPlaneNamespacePrefix }}
{{- $nvcfNamespace := printf "%snvcf" $controlPlaneNamespacePrefix }}
{{- $nvcfUiNamespace := printf "%snvcf-ui" $controlPlaneNamespacePrefix }}
{{- $sisNamespace := printf "%ssis" $controlPlaneNamespacePrefix }}
{{- $ingressNamespace := .Values.ingress.gatewayApi.controllerNamespace }}

repositories:
  - name: nvcf
{{- if $helmSourceURL }}
    url: {{ $helmSourceURL | quote }}
    {{- if dig "global" "helm" "sources" "username" "" .Values }}
    username: {{ dig "global" "helm" "sources" "username" "" .Values | quote }}
    {{- end }}
    {{- if dig "global" "helm" "sources" "password" "" .Values }}
    password: {{ dig "global" "helm" "sources" "password" "" .Values | quote }}
    {{- end }}
{{- else }}
    url: {{ .Values.global.helm.sources.registry }}/{{ .Values.global.helm.sources.repository }}
    oci: true
{{- end }}


helmDefaults:
  createNamespace: true
  devel: true
  timeout: 900
  wait: true
  waitForJobs: true
  diffArgs:
    - "--dry-run=server"

templates:
  service: &service
    chart: nvcf/helm-nvcf-{{`{{ .Release.Name }}`}}
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
      - ../secrets/{{ requiredEnv "HELMFILE_ENV" }}-secrets.yaml
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

releases:

  # --- NVCF Services ---
  - name: api-keys
    version: 1.8.0
    namespace: {{ $apiKeysNamespace }}
    inherit:
      - template: service

  - name: sis
    version: 2.3.0
    namespace: {{ $sisNamespace }}
    inherit:
      - template: service
    condition: icms.enabled

  - name: api
    version: 1.27.0
    namespace: {{ $nvcfNamespace }}
    inherit:
      - template: service
    needs:
      # not needed to start, but needed for bootstrapping account which is done with a script in the api helm chart
      - {{ $essNamespace }}/ess-api

  - name: nvct-api
    version: 1.6.0
    namespace: {{ $nvcfNamespace }}
    inherit:
      - template: service

  - name: invocation-service
    version: 1.6.1
    namespace: {{ $nvcfNamespace }}
    inherit:
      - template: service
    needs:
      - {{ $nvcfNamespace }}/api

  - name: grpc-proxy
    version: 1.7.3
    namespace: {{ $nvcfNamespace }}
    inherit:
      - template: service
    needs:
      - {{ $nvcfNamespace }}/api

  - name: ratelimiter
    chart: nvcf/helm-nvcf-rate-limiter
    version: 1.2.1
    namespace: {{ $nvcfNamespace }}
    condition: rateLimiter.enabled
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}
    needs:
      - {{ $nvcfNamespace }}/api

  - name: ess-api
    version: 1.8.2
    namespace: {{ $essNamespace }}
    inherit:
      - template: service

  - name: notary-service
    version: 1.6.0
    namespace: {{ $nvcfNamespace }}
    inherit:
      - template: service

  - name: admin-issuer-proxy
    chart: nvcf/helm-admin-token-issuer-proxy
    version: 1.5.2
    namespace: {{ $apiKeysNamespace }}
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    # Finding #22 (E2E 2026-04-20): admin-issuer-proxy was not installed by
    # the first make install. helmfile list showed INSTALLED=true but
    # helm list -A confirmed no release existed.
    #
    # Root cause: helmfile 1.1.9 processes releases layer-by-layer rather
    # than strictly DAG-aware. With needs: api-keys/api-keys, this release
    # was in DAG layer 2, waiting for ALL layer-1 peers to finish, not just
    # api-keys. On a clean k3d cluster the sis release in layer 1 can spend
    # up to 15 minutes stuck on multi-node sideload races before helmfile
    # aborts the sync; when sis fails (or the run is interrupted), layer 2
    # releases are silently skipped even though their specific dependency
    # (api-keys) completed successfully.
    #
    # Fix: drop the needs on api-keys/api-keys. The proxy does not require
    # api-keys to be running at install time. The api-keys namespace is
    # auto-created by helmDefaults.createNamespace=true, and api-keys is
    # only a runtime callee (serviceMetadataURL); runtime readiness is
    # handled by the pod readinessProbe, not install ordering. With no
    # needs, admin-issuer-proxy installs in DAG layer 1 in parallel with
    # api-keys/sis/ess-api and is immune to sibling flakes.
    #
    # Also add a release-group label so the release is consistent with its
    # peers (all other services in this file carry release-group: services).
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  - name: reval
    chart: nvcf/helm-reval
    version: 1.4.0
    namespace: {{ $nvcfNamespace }}
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  - name: nats-auth-callout-service
    chart: nvcf/helm-nvcf-nats-auth-callout-service
    version: 1.2.0
    namespace: {{ $natsNamespace }}
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
      {{- if .Values.global.imagePullSecrets }}
      - imagePullSecrets:
          {{- toYaml .Values.global.imagePullSecrets | nindent 10 }}
      {{- end }}
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  - name: llm-request-router
    {{- $llmRequestRouterChartPath := dig "addons" "llm" "requestRouter" "chartPath" "" .Values }}
    chart: {{ $llmRequestRouterChartPath | default "nvcf/helm-nvcf-llm-request-router" | quote }}
    {{- if not $llmRequestRouterChartPath }}
    version: 1.13.3
    {{- end }}
    namespace: {{ $nvcfNamespace }}
    condition: addons.llm.enabled
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    needs:
      - {{ $nvcfNamespace }}/api
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  - name: llm-api-gateway
    chart: nvcf/helm-nvcf-llm-api-gateway
    version: 1.4.3
    namespace: {{ $nvcfNamespace }}
    condition: addons.llm.enabled
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    needs:
      - {{ $nvcfNamespace }}/llm-request-router
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  - name: vanity-gateway
    version: 0.4.4
    namespace: {{ $nvcfNamespace }}
    condition: addons.vanityGateway.enabled
    inherit:
      - template: service
    needs:
      - {{ $nvcfNamespace }}/invocation-service
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  - name: nvcf-ui
    chart: nvcf/helm-nvcf-ui
    version: 1.1.2
    namespace: {{ $nvcfUiNamespace }}
    condition: addons.nvcfUi.enabled
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: services
      control-plane-owner: {{ $controlPlaneOwner | quote }}

  # --- Gateway API Ingress ---
  - name: ingress
    {{- $gatewayRoutesChartPath := dig "ingress" "gatewayApi" "chartPath" "" .Values }}
    chart: {{ $gatewayRoutesChartPath | default "nvcf/nvcf-gateway-routes" | quote }}
    {{- if not $gatewayRoutesChartPath }}
    version: 1.18.1
    {{- end }}
    needs:
      - {{ $nvcfNamespace }}/notary-service
      - {{ $apiKeysNamespace }}/api-keys
      {{- if dig "addons" "nvcfUi" "enabled" false .Values }}
      - {{ $nvcfUiNamespace }}/nvcf-ui
      {{- end }}
    namespace: {{ $ingressNamespace }}
    condition: ingress.gatewayApi.enabled
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: ingress
      control-plane-owner: {{ $controlPlaneOwner | quote }}
