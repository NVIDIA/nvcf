environments:
  default:
    values:
      - ../environments/base.yaml
      - ../environments/{{ requiredEnv "HELMFILE_ENV" }}.yaml

---

{{- $observabilityProfile := dig "observability" "profile" "disabled" .Values }}
{{- $controlPlaneOwnerRenderer := "../renderers/control-plane-owner-label.sh" }}
{{- $controlPlaneOwner := env "NVCF_CONTROL_PLANE_OWNER" | default "default" }}
{{- if or (eq $controlPlaneOwner "shared") (gt (len $controlPlaneOwner) 32) (not (regexMatch "^(default|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$" $controlPlaneOwner)) }}
{{- fail (printf "NVCF_CONTROL_PLANE_OWNER must be default or a lowercase DNS label up to 32 characters other than shared, got %q" $controlPlaneOwner) }}
{{- end }}
{{- if not (has $observabilityProfile (list "disabled" "control" "compute" "all")) }}
{{- fail (printf "observability.profile must be disabled, control, compute, or all, got %q" $observabilityProfile) }}
{{- end }}
{{- $functionAutoscalerEnabled := or (eq $observabilityProfile "control") (eq $observabilityProfile "all") }}
{{- if and $functionAutoscalerEnabled (not (dig "stateMetrics" "enabled" false .Values)) }}
{{- fail "function-autoscaler requires stateMetrics.enabled=true for control and all observability profiles" }}
{{- end }}

{{- $helmSourceURL := dig "global" "helm" "sources" "url" "" .Values }}
{{- $helmSourceURLIsLoopbackHTTP := or (hasPrefix "http://127.0.0.1:" $helmSourceURL) (hasPrefix "http://localhost:" $helmSourceURL) }}
{{- if and $helmSourceURL (not (or (hasPrefix "https://" $helmSourceURL) $helmSourceURLIsLoopbackHTTP)) }}
{{- fail "global.helm.sources.url must use https:// unless it points at local loopback HTTP for tests" }}
{{- end }}

repositories:
  - name: nvcf
{{- if $helmSourceURL }}
    url: {{ $helmSourceURL | quote }}
    {{- if dig "global" "helm" "sources" "username" "" .Values }}
    username: {{ dig "global" "helm" "sources" "username" "" .Values | quote }}
    {{- end }}
    {{- if dig "global" "helm" "sources" "password" "" .Values }}
    password: {{ dig "global" "helm" "sources" "password" "" .Values | quote }}
    {{- end }}
{{- else }}
    url: {{ .Values.global.helm.sources.registry }}/{{ .Values.global.helm.sources.repository }}
    oci: true
{{- end }}

helmDefaults:
  createNamespace: true
  devel: true
  timeout: 900
  wait: true
  waitForJobs: true
  diffArgs:
    - "--dry-run=server"

templates:
  service: &service
    chart: nvcf/helm-nvcf-{{`{{ .Release.Name }}`}}
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
      - ../secrets/{{ requiredEnv "HELMFILE_ENV" }}-secrets.yaml
    labels:
      release-group: observability
      control-plane-owner: {{ $controlPlaneOwner | quote }}
  functionAutoscaler: &functionAutoscaler
    chart: nvcf/helm-nvcf-function-autoscaler
    postRenderer: {{ $controlPlaneOwnerRenderer | quote }}
    postRendererArgs:
      - "--owner"
      - {{ $controlPlaneOwner | quote }}
    values:
      - ../global.yaml.gotmpl
    labels:
      release-group: observability
      control-plane-owner: {{ $controlPlaneOwner | quote }}

releases:

  # --- Observability Services ---
  - name: state-metrics
    version: 1.0.2
    namespace: nvcf
    condition: stateMetrics.enabled # From global.yaml.gotmpl or env overrides
    inherit:
      - template: service
    # When enabled, this service will export realtime function information that can be
    # scraped by a Prometheus ServiceMonitor

  {{- if $functionAutoscalerEnabled }}
  - name: function-autoscaler
    version: 0.4.0
    namespace: nvcf
    inherit:
      - template: functionAutoscaler
    needs:
      - nvcf/state-metrics
  {{- end }}
