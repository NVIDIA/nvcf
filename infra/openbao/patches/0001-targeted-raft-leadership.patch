+// Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"context"
+	"testing"
+
+	"github.com/hashicorp/raft"
+	autopilot "github.com/hashicorp/raft-autopilot"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLeadershipTransferTarget(t *testing.T) {
+	for _, name := range []string{"valid third voter", "empty", "self", "unknown", "nonvoter", "missing health", "unhealthy cluster", "stale leader", "missing target", "unhealthy target", "dead target", "healthy lagging voter", "address changed", "not promoted"} {
+		t.Run(name, func(t *testing.T) {
+			cfg := raft.Configuration{Servers: []raft.Server{{ID: "node0", Address: "0:8201", Suffrage: raft.Voter}, {ID: "node1", Address: "1:8201", Suffrage: raft.Voter}, {ID: "node2", Address: "2:8201", Suffrage: raft.Voter}}}
+			state := &autopilot.State{Healthy: true, Leader: "node0", Servers: map[raft.ServerID]*autopilot.ServerState{}}
+			for _, s := range cfg.Servers {
+				state.Servers[s.ID] = &autopilot.ServerState{Server: autopilot.Server{ID: s.ID, Address: s.Address, NodeStatus: autopilot.NodeAlive}, State: autopilot.RaftVoter, Health: autopilot.ServerHealth{Healthy: true}, Stats: autopilot.ServerStats{LastTerm: 5, LastIndex: 40}}
+			}
+			target := raft.ServerID("node2")
+			switch name {
+			case "empty":
+				target = ""
+			case "self":
+				target = "node0"
+			case "unknown":
+				target = "unknown"
+			case "nonvoter":
+				cfg.Servers[2].Suffrage = raft.Nonvoter
+			case "missing health":
+				state = nil
+			case "unhealthy cluster":
+				state.Healthy = false
+			case "stale leader":
+				state.Leader = "node1"
+			case "missing target":
+				delete(state.Servers, "node2")
+			case "unhealthy target":
+				state.Servers["node2"].Health.Healthy = false
+			case "dead target":
+				state.Servers["node2"].Server.NodeStatus = autopilot.NodeFailed
+			case "healthy lagging voter":
+				state.Servers["node2"].Stats.LastIndex = 39
+			case "address changed":
+				state.Servers["node2"].Server.Address = "old:8201"
+			case "not promoted":
+				state.Servers["node2"].State = autopilot.RaftNonVoter
+			}
+			address, err := leadershipTransferTarget("node0", target, cfg, state)
+			if name == "valid third voter" || name == "healthy lagging voter" {
+				require.NoError(t, err)
+				require.Equal(t, raft.ServerAddress("2:8201"), address)
+			} else {
+				require.ErrorIs(t, err, ErrInvalidLeadershipTransfer)
+				require.Empty(t, address)
+			}
+		})
+	}
+}
+
+func TestLeadershipTransferUninitializedAndCanceled(t *testing.T) {
+	b := &RaftBackend{}
+	require.ErrorContains(t, b.TransferLeadership(context.Background(), "node2"), "not initialized")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, b.TransferLeadership(ctx, "node2"), context.Canceled)
+}
