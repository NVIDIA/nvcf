@@ -0,0 +1,39 @@
+// Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: MPL-2.0
+
+package vault
+
+import (
+	"context"
+	"errors"
+
+	"github.com/openbao/openbao/helper/namespace"
+	"github.com/openbao/openbao/physical/raft"
+	"github.com/openbao/openbao/sdk/v2/framework"
+	"github.com/openbao/openbao/sdk/v2/logical"
+)
+
+func (b *SystemBackend) handleRaftTransferLeadership(ctx context.Context, req *logical.Request, data *framework.FieldData) (*logical.Response, error) {
+	ns, err := namespace.FromContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if ns.ID != namespace.RootNamespaceID {
+		return nil, logical.ErrPermissionDenied
+	}
+	target := data.Get("server_id").(string)
+	if len(target) == 0 || len(target) > maxServerIDLength {
+		return logical.ErrorResponse("a valid server_id is required"), logical.ErrInvalidRequest
+	}
+	backend := b.Core.GetRaftBackend()
+	if backend == nil {
+		return logical.ErrorResponse("raft storage is not in use"), logical.ErrInvalidRequest
+	}
+	if err := backend.TransferLeadership(ctx, target); err != nil {
+		if errors.Is(err, raft.ErrInvalidLeadershipTransfer) {
+			return logical.ErrorResponse(err.Error()), logical.ErrInvalidRequest
+		}
+		return nil, err
+	}
+	return nil, nil
+}
