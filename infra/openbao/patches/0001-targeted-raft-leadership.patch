+
+package raft
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	metrics "github.com/hashicorp/go-metrics/compat"
+	"github.com/hashicorp/raft"
+	autopilot "github.com/hashicorp/raft-autopilot"
+)
+
+// ErrInvalidLeadershipTransfer indicates that the target or cluster is unsuitable.
+var ErrInvalidLeadershipTransfer = errors.New("invalid leadership transfer")
+
+// TransferLeadership requests a healthy existing voter without changing membership.
+// Raft bounds the transfer by its election timeout and catches the target up before
+// requesting an election. Core's existing lost-leadership path performs HA teardown.
+func (b *RaftBackend) TransferLeadership(ctx context.Context, target string) error {
+	defer metrics.MeasureSince([]string{"raft-storage", "transfer-leadership"}, time.Now())
+	b.l.RLock()
+	defer b.l.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if b.raft == nil {
+		return errors.New("raft storage is not initialized")
+	}
+	if b.raft.State() != raft.Leader {
+		return raft.ErrNotLeader
+	}
+	if b.autopilot == nil {
+		return ErrRaftAutopilotNotInitialized
+	}
+	configuration := b.raft.GetConfiguration()
+	if err := configuration.Error(); err != nil {
+		return err
+	}
+	address, err := leadershipTransferTarget(raft.ServerID(b.localID), raft.ServerID(target), configuration.Configuration(), b.autopilot.GetState())
+	if err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	b.logger.Info("transferring raft leadership", "target_id", target)
+	if err := b.raft.LeadershipTransferToServer(raft.ServerID(target), address).Error(); err != nil {
+		metrics.IncrCounter([]string{"raft-storage", "transfer-leadership", "error"}, 1)
+		return fmt.Errorf("raft leadership transfer to %q failed: %w", target, err)
+	}
+	metrics.IncrCounter([]string{"raft-storage", "transfer-leadership", "success"}, 1)
+	return nil
+}
+
+func leadershipTransferTarget(local, target raft.ServerID, config raft.Configuration, state *autopilot.State) (raft.ServerAddress, error) {
+	if target == "" || target == local {
+		return "", fmt.Errorf("%w: target must be a different existing voter", ErrInvalidLeadershipTransfer)
+	}
+	var address raft.ServerAddress
+	for _, server := range config.Servers {
+		if server.ID == target && server.Suffrage == raft.Voter {
+			address = server.Address
+		}
+	}
+	if address == "" {
+		return "", fmt.Errorf("%w: target is not an existing voter", ErrInvalidLeadershipTransfer)
+	}
+	if state == nil || !state.Healthy || state.Leader != local {
+		return "", fmt.Errorf("%w: healthy current-leader Autopilot state is required", ErrInvalidLeadershipTransfer)
+	}
+	leader, follower := state.Servers[local], state.Servers[target]
+	if leader == nil || follower == nil || !follower.Health.Healthy || follower.Server.NodeStatus != autopilot.NodeAlive || !follower.HasVotingRights() || follower.Server.Address != address {
+		return "", fmt.Errorf("%w: target is not a healthy voter in current Autopilot state", ErrInvalidLeadershipTransfer)
+	}
+	// Autopilot samples can lag ongoing writes. Raft checks its live replication
+	// index and catches the target up before sending TimeoutNow.
+	return address, nil
+}
