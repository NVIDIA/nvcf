load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "prober",
    srcs = ["prober.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/prober",
    visibility = ["//src/compute-plane-services/pylon-operator:__subpackages__"],
    deps = [
        "//src/compute-plane-services/pylon-operator/api/v1alpha1",
        "//src/compute-plane-services/pylon-operator/internal/metrics",
        "@io_k8s_api//core/v1:core",
