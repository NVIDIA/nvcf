load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gds",
    srcs = ["gds.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/gds",
    visibility = ["//src/compute-plane-services/pylon-operator:__subpackages__"],
    deps = [
        "//src/compute-plane-services/pylon-operator/internal/config",
        "//src/compute-plane-services/pylon-operator/internal/transport",
        "//src/compute-plane-services/pylon-operator/internal/version",
        "//src/control-plane-services/global-discovery/api/gen/go/nvidia/gds/v1:gds",
        "//src/control-plane-services/global-discovery/pkg/client",
        "@com_github_go_logr_logr//:logr",
        "@com_github_prometheus_client_golang//prometheus",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_sigs_controller_runtime//pkg/client",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gds",
    visibility = ["//src/compute-plane-services/pylon-operator:__subpackages__"],
)

go_test(
    name = "gds_test",
    srcs = ["gds_test.go"],
    embed = [":gds"],
    deps = [
        "//src/compute-plane-services/pylon-operator/internal/config",
        "//src/control-plane-services/global-discovery/pkg/fakegds",
        "@com_github_go_logr_logr//:logr",
        "@com_github_go_logr_logr//funcr",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
    ],
)
