load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "version",
    srcs = ["version.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/version",
    visibility = ["//src/compute-plane-services/pylon-operator:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":version",
    visibility = ["//src/compute-plane-services/pylon-operator:__subpackages__"],
)

go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    embed = [":version"],
    deps = ["@com_github_stretchr_testify//assert"],
)
