load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "pylon-operator_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/cmd/pylon-operator",
    visibility = ["//visibility:private"],
    deps = [
        "//src/compute-plane-services/pylon-operator/internal/config",
        "//src/compute-plane-services/pylon-operator/internal/controller",
        "//src/compute-plane-services/pylon-operator/internal/gpu",
        "//src/compute-plane-services/pylon-operator/internal/metrics",
        "//src/compute-plane-services/pylon-operator/internal/prober",
        "//src/compute-plane-services/pylon-operator/internal/registration",
        "//src/compute-plane-services/pylon-operator/internal/transport",
        "//src/compute-plane-services/pylon-operator/internal/version",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/healthz",
        "@io_k8s_sigs_controller_runtime//pkg/log/zap",
        "@io_k8s_sigs_controller_runtime//pkg/metrics",
    ],
)

go_binary(
    name = "pylon-operator",
    embed = [":pylon-operator_lib"],
    visibility = ["//visibility:public"],
    # x_defs lives on go_binary, not go_library, so tests never see the
    # empty {STABLE_*} values an unstamped build substitutes.
    x_defs = {
        "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/version.Service": "nvcf-pylon-operator",
        "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/version.Version": "{STABLE_VERSION}",
        "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/version.GitHash": "{STABLE_GIT_COMMIT_FULL}",
        "github.com/NVIDIA/nvcf/src/compute-plane-services/pylon-operator/internal/version.ReleaseTag": "{STABLE_OCI_TAG}",
    },
)
