load("@nvstor_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//src/compute-plane-services/nvstor:__subpackages__"])

# build.rs links libibverbs (rdma-core) for the target. The linker finds it in
# the toolchain's default search path (libibverbs-dev installed on the build
# host), or under $RDMA_CORE_PREFIX/lib/<arch>-linux-gnu when the action env
# sets RDMA_CORE_PREFIX: `--action_env=RDMA_CORE_PREFIX=/usr` for an arm64
# cross build against multiarch libibverbs-dev:arm64, or an unpacked rdma-core
# tree. The rdma-cm feature (src/cm.c, librdmacm) is not built here: nvstor-peer
# does not use it.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    edition = "2021",
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "nvstor-rdma",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "nvstor_rdma",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":build_script",
        "//src/compute-plane-services/nvstor/crates/nvstor-core",
    ] + all_crate_deps(normal = True),
)

# Tests that need an ACTIVE RDMA device are #[ignore]d and run by hand on RDMA
# hardware (cargo test -p nvstor-rdma -- --ignored).
rust_test(
    name = "nvstor-rdma_test",
    size = "medium",
    aliases = aliases(normal_dev = True),
    crate = ":nvstor-rdma",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
