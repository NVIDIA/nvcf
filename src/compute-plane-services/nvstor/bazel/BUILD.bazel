load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//src/compute-plane-services/nvstor:__subpackages__"])

exports_files(["image_layer_test.sh"])

# rdma-core for the target architecture (rdma_core.bzl): the tree
# nvstor-rdma's build script links against, and the image layer that carries
# the libraries at run time.
alias(
    name = "rdma_core_dev_prefix",
    actual = select({
        "@platforms//cpu:arm64": "@nvstor_rdma_core_arm64//:dev_prefix",
        "@platforms//cpu:x86_64": "@nvstor_rdma_core_amd64//:dev_prefix",
    }),
)

alias(
    name = "rdma_core_runtime_libdir",
    actual = select({
        "@platforms//cpu:arm64": "@nvstor_rdma_core_arm64//:runtime_libdir",
        "@platforms//cpu:x86_64": "@nvstor_rdma_core_amd64//:runtime_libdir",
    }),
)

alias(
    name = "rdma_core_runtime_layer",
    actual = select({
        "@platforms//cpu:arm64": "@nvstor_rdma_core_arm64//:runtime_layer",
        "@platforms//cpu:x86_64": "@nvstor_rdma_core_amd64//:runtime_layer",
    }),
)

# Both architectures' layers, whatever the host: the files are only listed.
[
    sh_test(
        name = "rdma_core_runtime_layer_%s_test" % arch,
        size = "small",
        srcs = ["image_layer_test.sh"],
        args = [
            "runtime",
            "$(rootpath @nvstor_rdma_core_%s//:runtime_layer)" % arch,
        ],
        data = ["@nvstor_rdma_core_%s//:runtime_layer" % arch],
    )
    for arch in ("amd64", "arm64")
]
