load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//rules/oci:defs.bzl", "go_oci_image")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/worker-task/cmd",
    visibility = ["//visibility:private"],
    deps = ["//src/compute-plane-services/worker-task/service"],
)

go_binary(
    name = "worker-task",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
    x_defs = {
        "github.com/NVIDIA/nvcf/src/libraries/go/lib/pkg/version.Version": "{STABLE_VERSION}",
        "github.com/NVIDIA/nvcf/src/libraries/go/lib/pkg/version.GitHash": "{STABLE_GIT_COMMIT_FULL}",
    },
)

go_oci_image(
    name = "image",
    base = "@distroless_go",
    binary = ":worker-task",
    user = "1000:1000",
    tags = ["nvcf-worker-task"],
    visibility = ["//visibility:public"],
)

# Inspect the built index so named-user defaults cannot pass admission checks.
go_test(
    name = "image_user_test",
    srcs = ["//rules/oci/private:numeric_user_test.go"],
    args = [
        "-image_index=$(location :image_index)",
        "-expected_user=1000:1000",
    ],
    data = [":image_index"],
)
