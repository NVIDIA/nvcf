load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "compat",
    srcs = [
        "compat.go",
        "python.go",
    ],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/request-trace-uploader/transform/compat",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":compat",
    visibility = ["//visibility:public"],
)

go_test(
    name = "compat_test",
    srcs = ["compat_test.go"],
    data = glob(["testdata/**"]),
    embed = [":compat"],
)
