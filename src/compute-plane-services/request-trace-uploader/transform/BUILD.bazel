load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "transform",
    srcs = [
        "files.go",
        "transform.go",
    ],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/request-trace-uploader/transform",
    visibility = ["//visibility:public"],
    deps = [
        "//src/compute-plane-services/request-trace-uploader/record",
        "//src/compute-plane-services/request-trace-uploader/transform/compat",
        "//src/compute-plane-services/request-trace-uploader/transform/redact",
        "//src/compute-plane-services/request-trace-uploader/transform/suppress",
    ],
)

alias(
    name = "go_default_library",
    actual = ":transform",
    visibility = ["//visibility:public"],
)

go_test(
    name = "transform_test",
    srcs = [
        "files_test.go",
        "pipeline_test.go",
        "transform_test.go",
    ],
    embed = [":transform"],
    deps = [
        "//src/compute-plane-services/request-trace-uploader/segment",
        "//src/compute-plane-services/request-trace-uploader/transform/compat",
        "//src/compute-plane-services/request-trace-uploader/transform/suppress",
    ],
)
