load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = [
        "aliases.go",
        "config.go",
        "suppression.go",
    ],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/request-trace-uploader/config",
    visibility = ["//visibility:public"],
    deps = ["//src/compute-plane-services/request-trace-uploader/transform/suppress"],
)

go_test(
    name = "config_test",
    srcs = [
        "aliases_test.go",
        "config_test.go",
        "suppression_test.go",
    ],
    embed = [":config"],
    deps = ["//src/compute-plane-services/request-trace-uploader/transform/suppress"],
)

alias(
    name = "go_default_library",
    actual = ":config",
    visibility = ["//visibility:public"],
)
