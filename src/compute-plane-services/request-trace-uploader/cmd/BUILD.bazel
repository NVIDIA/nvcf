load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//rules/oci:defs.bzl", "go_oci_image")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/request-trace-uploader/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//src/compute-plane-services/request-trace-uploader/backend/debug",
        "//src/compute-plane-services/request-trace-uploader/backend/objectstore",
        "//src/compute-plane-services/request-trace-uploader/runner",
    ],
)

go_binary(
    name = "request-trace-uploader",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
)

go_oci_image(
    name = "image",
    base = "@distroless_go",
    binary = ":request-trace-uploader",
    tags = ["nvcf-request-trace-uploader"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cmd_test",
    srcs = [
        "control_test.go",
        "main_test.go",
        "metrics_test.go",
        "strict_test.go",
    ],
    embed = [":cmd_lib"],
    deps = [
        "//src/compute-plane-services/request-trace-uploader/config",
        "//src/compute-plane-services/request-trace-uploader/telemetry",
        "//src/compute-plane-services/request-trace-uploader/telemetry/otlp",
        "@io_opentelemetry_go_proto_otlp//collector/metrics/v1:metrics",
        "@org_golang_google_protobuf//proto",
    ],
)
