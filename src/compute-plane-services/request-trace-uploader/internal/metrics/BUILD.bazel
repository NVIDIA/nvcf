load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "metrics",
    srcs = ["metrics.go"],
    importpath = "github.com/NVIDIA/nvcf/src/compute-plane-services/request-trace-uploader/internal/metrics",
    visibility = ["//src/compute-plane-services/request-trace-uploader:__subpackages__"],
    deps = [
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
    ],
)

go_test(
    name = "metrics_test",
    srcs = ["metrics_test.go"],
    embed = [":metrics"],
    deps = ["@com_github_prometheus_client_golang//prometheus"],
)

alias(
    name = "go_default_library",
    actual = ":metrics",
    visibility = ["//src/compute-plane-services/request-trace-uploader:__subpackages__"],
)
