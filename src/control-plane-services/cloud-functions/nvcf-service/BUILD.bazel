load(
    "//rules/java:defs.bzl",
    "NVCF_JAVA_ERROR_PRONE_COMPAT_JAVACOPTS",
    "nvcf_java_coverage_test",
    "nvcf_java_library",
    "nvcf_java_test",
)
load("//rules/java:spring.bzl", "spring_boot_app")
load("//rules/oci:defs.bzl", "java_image_contract_test", "java_oci_image")

package(default_visibility = ["//visibility:public"])

NVCF_SERVICE_SRCS = glob(["src/main/java/**/*.java"])

NVCF_SERVICE_RESOURCES = glob(["src/main/resources/**"])

NVCF_SERVICE_TEST_SRCS = glob(["src/test/java/**/*.java"])

NVCF_SERVICE_TEST_RESOURCES = glob(["src/test/resources/**"]) + [
    "//src/control-plane-services/cloud-functions:integration_local_env_files",
]

NVCF_SERVICE_DEPS = [
    "//src/control-plane-services/cloud-functions/nvcf-core:nvcf_core",
    "@nv_third_party_deps//:net_devh_grpc_server_spring_boot_starter",
    "@nv_third_party_deps//:org_slf4j_slf4j_api",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_autoconfigure",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_loader",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_micrometer_tracing",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_security",
]

nvcf_java_library(
    name = "app_classes",
    srcs = NVCF_SERVICE_SRCS,
    deps = NVCF_SERVICE_DEPS,
    javacopts = NVCF_JAVA_ERROR_PRONE_COMPAT_JAVACOPTS,
    resource_strip_prefix = "src/control-plane-services/cloud-functions/nvcf-service/src/main/resources",
    resources = NVCF_SERVICE_RESOURCES,
    visibility = ["//visibility:private"],
)

spring_boot_app(
    name = "app",
    application = ":app_classes",
    artifact_id = "nvcf-service-oss",
    artifact_name = "NVCF Service OSS",
    artifact_version = "0.0.1-SNAPSHOT",
    description = "NVIDIA Cloud Functions OSS executable",
    group_id = "com.nvidia.nvcf",
    main_class = "com.nvidia.nvcf.App",
)

nvcf_java_test(
    name = "tests",
    srcs = NVCF_SERVICE_TEST_SRCS,
    javacopts = NVCF_JAVA_ERROR_PRONE_COMPAT_JAVACOPTS,
    deps = [
        ":app_classes",
        "//src/control-plane-services/cloud-functions/nvcf-core:nvcf_core",
        "//src/control-plane-services/cloud-functions/nvcf-core:nvcf_core_test_fixtures",
        "//src/libraries/java/nv-boot-parent/nv-boot-mock-servers-test:nv_boot_mock_servers_test",
        "@nv_third_party_deps//:io_opentelemetry_opentelemetry_sdk_testing",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_restclient",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_resttestclient",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_starter_webmvc_test",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_web_server",
        "@nv_third_party_deps//:org_springframework_spring_beans",
        "@nv_third_party_deps//:org_springframework_spring_web",
        "@nv_third_party_deps//:org_springframework_spring_webmvc",
        "@nv_third_party_deps//:org_testcontainers_testcontainers",
        "@nv_third_party_deps//:org_testcontainers_testcontainers_cassandra",
        "@nv_third_party_deps//:org_slf4j_slf4j_api",
        "@nv_third_party_deps//:org_wiremock_wiremock_standalone",
    ],
    data = [
        "//src/control-plane-services/cloud-functions:integration_local_env",
    ],
    resources = NVCF_SERVICE_TEST_RESOURCES,
    size = "large",
    tags = [
        "exclusive",
        "requires-docker",
    ],
    timeout = "long",
)

nvcf_java_coverage_test(
    name = "tests_coverage",
    coverage_target = ":app_classes",
    size = "large",
    tags = [
        "exclusive",
        "requires-docker",
    ],
    test = ":tests",
    timeout = "long",
)

# Release image. Push the _index label (multi-arch amd64 + arm64), never
# :nvcf-service-oss-image, which is the single host-arch image.
#
# Runtime parity with the pre-Bazel nvcf-service/Dockerfile, which is the
# contract this image must preserve:
#   COPY app.jar /usr/share/app.jar
#   ENV ULIMIT_FLAG=1
#   ENV JDK_JAVA_OPTIONS="-XX:MaxRAMPercentage=40.0 ..."
#   WORKDIR /home/app
#   CMD ["java", "-jar", "/usr/share/app.jar"]
#
# ULIMIT_FLAG is load-bearing, not decoration: the base's shelless_ulimit shim
# reads it, so without it the shim runs and raises nothing. JDK_JAVA_OPTIONS
# carries the container heap sizing (MaxRAMPercentage), so dropping it silently
# changes JVM memory behavior in production.
java_oci_image(
    name = "nvcf-service-oss-image",
    jar = ":app",
    jar_path = "/usr/share/app.jar",
    env = {
        "ULIMIT_FLAG": "1",
        "JDK_JAVA_OPTIONS": "-XX:MaxRAMPercentage=40.0 -XX:+EnableDynamicAgentLoading -Dreactor.netty.pool.maxIdleTime=30000 -Dreactor.netty.pool.maxConnections=500",
    },
    workdir = "/home/app",
)

# Runtime-contract guard for the image, shared with every other Java service
# so the assertions cannot drift apart between them.
java_image_contract_test(
    name = "image_contract_test",
    image = ":nvcf-service-oss-image",
    jar_path = "/usr/share/app.jar",
    env = {
        "ULIMIT_FLAG": "1",
        "JDK_JAVA_OPTIONS": "-XX:MaxRAMPercentage=40.0 -XX:+EnableDynamicAgentLoading -Dreactor.netty.pool.maxIdleTime=30000 -Dreactor.netty.pool.maxConnections=500",
    },
    workdir = "/home/app",
)
