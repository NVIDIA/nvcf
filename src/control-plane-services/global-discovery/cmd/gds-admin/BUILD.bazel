load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gds-admin_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/cmd/gds-admin",
    visibility = ["//visibility:private"],
    deps = ["//src/control-plane-services/global-discovery/cmd/gds-admin/createtable"],
)

go_binary(
    name = "gds-admin",
    embed = [":gds-admin_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gds-admin_test",
    srcs = ["main_test.go"],
    embed = [":gds-admin_lib"],
    deps = ["@com_github_stretchr_testify//assert"],
)
