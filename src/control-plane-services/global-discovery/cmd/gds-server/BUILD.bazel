load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gds-server_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/cmd/gds-server",
    visibility = ["//visibility:private"],
    deps = [
        "//src/control-plane-services/global-discovery/internal/config",
        "//src/control-plane-services/global-discovery/internal/version",
    ],
)

go_binary(
    name = "gds-server",
    embed = [":gds-server_lib"],
    visibility = ["//visibility:public"],
    # x_defs lives on go_binary, not go_library, so tests never see the
    # empty {STABLE_*} values an unstamped build substitutes.
    x_defs = {
        "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/version.Service": "nvcf-gds-server",
        "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/version.Version": "{STABLE_VERSION}",
        "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/version.GitHash": "{STABLE_GIT_COMMIT_FULL}",
        "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/version.ReleaseTag": "{STABLE_OCI_TAG}",
    },
)

go_test(
    name = "gds-server_test",
    srcs = ["main_test.go"],
    embed = [":gds-server_lib"],
    deps = ["@com_github_stretchr_testify//assert"],
)
