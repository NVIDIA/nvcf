load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "crd",
    srcs = ["crd.go"],
    embedsrcs = ["bases/about.k8s.io_clusterproperties.yaml"],
    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/config/crd",
    visibility = ["//visibility:public"],
    deps = ["@io_k8s_sigs_mcs_api//config/crd"],
)

alias(
    name = "go_default_library",
    actual = ":crd",
    visibility = ["//visibility:public"],
)

go_test(
    name = "crd_test",
    srcs = ["crd_test.go"],
    embed = [":crd"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)
