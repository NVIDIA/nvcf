load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "client",
    srcs = [
        "cache.go",
        "client.go",
        "config.go",
        "conntrack.go",
        "doc.go",
        "errors.go",
        "generation.go",
        "metrics.go",
        "poolcache.go",
        "resolver.go",
        "routercache.go",
        "subclients.go",
        "watch.go",
    ],
    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/pkg/client",
    visibility = ["//visibility:public"],
    deps = [
        "//src/control-plane-services/global-discovery/api",
        "//src/control-plane-services/global-discovery/api/gen/go/nvidia/gds/v1:gds",
        "@com_github_prometheus_client_golang//prometheus",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//backoff",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//resolver",
