load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules/oci:defs.bzl", "go_oci_image")

# BUILD files in this module are generated by the root Gazelle:
#   bazel run //:gazelle -- src/control-plane-services/global-discovery
# There is deliberately no module-local gazelle target: run without arguments
# it would walk the whole repository.
#
# The generated Go for api/proto is checked in under api/gen/go and built as a
# plain go_library, so Gazelle must not emit proto_library or go_proto_library
# rules for the .proto sources.
# gazelle:prefix github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery
# gazelle:proto disable_global
# gazelle:go_naming_convention import_alias
# gazelle:exclude _output
# gazelle:exclude hack

# Build/load/index/tar targets. Publishing is owned by the release pipeline,
# which copies :image_index and :admin_image_index by digest. Both load
# targets tag the image src/control-plane-services/global-discovery:latest,
# so load one, retag it, then load the other.
go_oci_image(
    name = "image",
    base = "@distroless_go",
    binary = "//src/control-plane-services/global-discovery/cmd/gds-server",
    binary_path = "/usr/bin/gds-server",
    tags = ["nvcf-global-discovery"],
    visibility = ["//visibility:public"],
)

go_oci_image(
    name = "admin_image",
    base = "@distroless_go",
    binary = "//src/control-plane-services/global-discovery/cmd/gds-admin",
    binary_path = "/usr/bin/gds-admin",
    tags = ["nvcf-global-discovery-admin"],
    visibility = ["//visibility:public"],
)

# Regression guards for the rules_pkg default-0644 startup failure: each fails
# when the entrypoint in the image layer is not executable.
sh_test(
    name = "image_entrypoint_mode_test",
    srcs = ["image_entrypoint_mode_test.sh"],
    args = [
        "$(location :image.tar)",
        "usr/bin/gds-server",
    ],
    data = [":image.tar"],
)

sh_test(
    name = "admin_image_entrypoint_mode_test",
    srcs = ["image_entrypoint_mode_test.sh"],
    args = [
        "$(location :admin_image.tar)",
        "usr/bin/gds-admin",
    ],
    data = [":admin_image.tar"],
)

# gds-mcs-controller image. Build/load/index/tar targets; publishing is owned
# by the release pipeline, which copies :controller_image_index by digest.
go_oci_image(
    name = "controller_image",
    base = "@distroless_go",
    binary = "//src/control-plane-services/global-discovery/cmd/gds-mcs-controller",
    binary_path = "/usr/bin/gds-mcs-controller",
    tags = ["nvcf-gds-mcs-controller"],
    visibility = ["//visibility:public"],
)

# Regression guard for the rules_pkg default-0644 startup failure: fails when
# the entrypoint in the image layer is not executable.
sh_test(
    name = "controller_image_entrypoint_mode_test",
    srcs = ["image_entrypoint_mode_test.sh"],
    args = [
        "$(location :controller_image.tar)",
        "usr/bin/gds-mcs-controller",
    ],
    data = [":controller_image.tar"],
)
