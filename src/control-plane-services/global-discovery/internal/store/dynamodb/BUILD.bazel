    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/store/dynamodb",
    visibility = ["//src/control-plane-services/global-discovery:__subpackages__"],
    deps = [
        "//src/control-plane-services/global-discovery/api/gen/go/nvidia/gds/v1:gds",
        "//src/control-plane-services/global-discovery/internal/store",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_feature_dynamodb_attributevalue//:attributevalue",
