    data = glob(["testdata/**"]),
    embed = [":dynamodb"],
    deps = [
        "//src/control-plane-services/global-discovery/api/gen/go/nvidia/gds/v1:gds",
        "//src/control-plane-services/global-discovery/internal/store",
        "//src/control-plane-services/global-discovery/internal/store/storetest",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//:dynamodb",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//types",
        "@com_github_aws_smithy_go//:smithy-go",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//proto",
    ],
)

# Integration tests against amazon/dynamodb-local in Docker (make
# test-integration). Gazelle leaves integration_test.go out of dynamodb_test
# because of its build tag, so this target is kept by hand and compiles it
# with gotags. local, env_inherit and the tags follow
# //src/invocation-plane-services/grpc-proxy/proxy/geo:geo_test: the sandbox
# hides the Docker socket, and the effective inputs (daemon, image) live
# outside Bazel's action hash. Filter it out with
# --test_tag_filters=-requires-docker where Docker is unavailable; without a
# daemon the tests skip.
# keep
go_test(
    name = "dynamodb_integration_test",
    srcs = ["integration_test.go"],
    env_inherit = [
        "PATH",
        "DOCKER_HOST",
        "DOCKER_TLS_CERTDIR",
        "DOCKER_CERT_PATH",
        "DOCKER_TLS_VERIFY",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "GDS_TEST_DYNAMODB_ENDPOINT",
    ],
    gotags = ["integration"],
    local = True,
    tags = [
        "external",
        "requires-docker",
    ],
    deps = [
        ":dynamodb",
        "//src/control-plane-services/global-discovery/internal/store",
        "//src/control-plane-services/global-discovery/internal/store/dynamodb/dynamodblocal",
        "//src/control-plane-services/global-discovery/internal/store/storetest",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//:dynamodb",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//types",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
