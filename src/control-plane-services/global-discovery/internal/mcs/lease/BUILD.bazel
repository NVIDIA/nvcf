load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lease",
    srcs = ["lease.go"],
    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/mcs/lease",
    visibility = ["//src/control-plane-services/global-discovery:__subpackages__"],
    deps = [
        "//src/control-plane-services/global-discovery/api/gen/go/nvidia/gds/v1:gds",
        "//src/control-plane-services/global-discovery/internal/mcs/identity",
        "//src/control-plane-services/global-discovery/internal/mcs/metrics",
        "//src/control-plane-services/global-discovery/internal/mcs/tracing",
        "//src/control-plane-services/global-discovery/pkg/client",
        "@com_github_go_logr_logr//:logr",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":lease",
    visibility = ["//src/control-plane-services/global-discovery:__subpackages__"],
)

go_test(
    name = "lease_test",
    srcs = ["lease_test.go"],
    deps = [
        ":lease",
        "//src/control-plane-services/global-discovery/api/gen/go/nvidia/gds/v1:gds",
        "//src/control-plane-services/global-discovery/internal/mcs/mcstest",
        "//src/control-plane-services/global-discovery/internal/mcs/metrics",
        "//src/control-plane-services/global-discovery/pkg/client",
        "@com_github_go_logr_logr//testr",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
