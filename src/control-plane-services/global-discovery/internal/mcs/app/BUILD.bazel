load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "app",
    srcs = ["app.go"],
    importpath = "github.com/NVIDIA/nvcf/src/control-plane-services/global-discovery/internal/mcs/app",
    visibility = ["//src/control-plane-services/global-discovery:__subpackages__"],
    deps = [
        "//src/control-plane-services/global-discovery/api",
        "//src/control-plane-services/global-discovery/internal/mcs/config",
        "//src/control-plane-services/global-discovery/internal/mcs/export",
        "//src/control-plane-services/global-discovery/internal/mcs/identity",
        "//src/control-plane-services/global-discovery/internal/mcs/importer",
        "//src/control-plane-services/global-discovery/internal/mcs/lease",
        "//src/control-plane-services/global-discovery/internal/mcs/metrics",
        "//src/control-plane-services/global-discovery/internal/version",
        "//src/control-plane-services/global-discovery/pkg/client",
        "@com_github_go_logr_logr//:logr",
        "@com_github_prometheus_client_golang//prometheus",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/healthz",
        "@io_k8s_sigs_controller_runtime//pkg/manager",
        "@io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc//:otelgrpc",
        "@org_golang_google_grpc//:grpc",
    ],
)

alias(
    name = "go_default_library",
    actual = ":app",
    visibility = ["//src/control-plane-services/global-discovery:__subpackages__"],
)

go_test(
    name = "app_test",
    srcs = ["app_test.go"],
    embed = [":app"],
    deps = [
        "//src/control-plane-services/global-discovery/api",
        "//src/control-plane-services/global-discovery/internal/mcs/config",
        "//src/control-plane-services/global-discovery/internal/mcs/identity",
        "//src/control-plane-services/global-discovery/internal/mcs/mcstest",
        "@com_github_go_logr_logr//testr",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/manager",
        "@io_k8s_utils//ptr",
    ],
)
