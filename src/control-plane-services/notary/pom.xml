<project
        xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nvidia.boot</groupId>
        <artifactId>nv-boot-parent</artifactId>
        <version>2.0.1</version>  <!-- Keep in sync with nv-boot.version defined below -->
        <relativePath/>
    </parent>

    <groupId>com.nvidia.notary</groupId>
    <artifactId>notary-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Notary API</name>
    <description>NVCF Notary — aggregator for core library and OSS executable.</description>

    <!--
      This POM remains for Maven parity. Bazel resolves nv-boot from direct
      source targets under //src/libraries/java/nv-boot-parent, so this public
      subtree does not declare a private artifact repository.
    -->

    <properties>
        <root.dir>${project.basedir}</root.dir>
        <nv-boot.version>2.0.1</nv-boot.version>  <!-- Keep in sync with parent version above  -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.nvidia.boot</groupId>
                <artifactId>nv-boot-bom</artifactId>
                <version>${nv-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>notary-core</module>
        <module>notary-service</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Default is 30s; notary integration tests tear down many Spring -->
                    <!-- contexts (gRPC + Tomcat graceful shutdown + reloadable props, etc.). -->
                    <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
                    <workingDirectory>${root.dir}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
