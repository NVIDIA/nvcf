<project
        xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nvidia.notary</groupId>
        <artifactId>notary-api</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>notary-service-oss</artifactId>
    <packaging>jar</packaging>
    <name>Notary Service OSS</name>
    <description>
        NVCF Notary — OSS executable
    </description>

    <properties>
        <start-class>com.nvidia.notary.App</start-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.nvidia.notary</groupId>
            <artifactId>notary-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test Dependencies -->
        <!-- notary-core test-jar provides the shared `integrationtest` profile fixtures      -->
        <!-- (application-integrationtest.yaml, bootstrap-integrationtest.yaml and the         -->
        <!-- vault-agent signing-key JSON) used by NotaryServiceIntegrationTest to boot App.   -->
        <dependency>
            <groupId>com.nvidia.notary</groupId>
            <artifactId>notary-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <configuration>
                    <!-- Repo root is parent aggregator (notary-api); module dir has no .git. -->
                    <dotGitDirectory>${project.parent.basedir}/.git</dotGitDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
