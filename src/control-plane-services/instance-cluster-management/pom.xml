<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nvidia.boot</groupId>
        <artifactId>nv-boot-parent</artifactId>
        <version>2.0.2</version>  <!-- Keep in sync with nv-boot.version defined below -->
        <relativePath/>
    </parent>

    <groupId>com.nvidia.icms</groupId>
    <artifactId>instance-cluster-management</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ICMS API</name>
    <description>
        NVIDIA Instance and Cluster Management Service (ICMS) — aggregator for the core library
        and deployment modules.
    </description>

    <!--
      This POM is kept for Maven parity only. In the monorepo the service is
      built with Bazel (//rules/java) and its nv-boot parent/BOM resolve from
      the in-tree source targets under //src/libraries/java/nv-boot-parent, not
      from a Maven repository, so no internal artifact server is referenced here.
    -->

    <properties>
        <root.dir>${project.basedir}</root.dir>
        <nv-boot.version>2.0.2</nv-boot.version>  <!-- Keep in sync with parent version above  -->
    </properties>

    <modules>
        <module>icms-core</module>
        <module>icms-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.nvidia.boot</groupId>
                <artifactId>nv-boot-bom</artifactId>
                <version>${nv-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Run tests from the repo root so module test code can resolve -->
                    <!-- shared relative paths such as local_env/... consistently.     -->
                    <workingDirectory>${root.dir}</workingDirectory>
                    <!-- Default is 30s; integration tests tear down many Spring contexts. -->
                    <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
