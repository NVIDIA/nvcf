<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- JSON console: Datadog cluster agent collects via kubelet API -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <excludeMdcKeyName>traceId</excludeMdcKeyName>
            <excludeMdcKeyName>spanId</excludeMdcKeyName>
            <provider class="com.nvidia.icms.configuration.logging.DatadogTraceIdJsonProvider"/>
        </encoder>
    </appender>

    <!-- Dedicated appender for Datadog event logs: outputs raw JSON only (no prefix) so DD auto-parses it -->
    <appender name="DD_EVENTS_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- datadog.events logger: sends only to the raw-JSON appender, not the main CONSOLE -->
    <logger name="datadog.events" level="INFO" additivity="false">
        <appender-ref ref="DD_EVENTS_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
