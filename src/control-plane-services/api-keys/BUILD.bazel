filegroup(
    name = "integration_local_env_files",
    srcs = [
        "local_env/docker-compose.test.yml",
    ] + glob([
        "local_env/cassandra/**",
        "local_env/vault/**",
    ]),
)

# Tests open local_env paths relative to the runfiles workspace root. Strip the
# imported package prefix to preserve the standalone repository layout.
nvcf_workspace_runfiles(
    name = "integration_local_env",
    srcs = [":integration_local_env_files"],
    strip_prefix = "src/control-plane-services/api-keys/",
)

java_library(
    name = "provided_compile_deps",
    exports = ["@nv_third_party_deps//:jakarta_servlet_jakarta_servlet_api"],
    neverlink = True,
    visibility = ["//visibility:private"],
)

nvcf_java_library(
    name = "app_classes",
    srcs = API_KEYS_SRCS,
    deps = API_KEYS_DEPS,
    resource_strip_prefix = "src/control-plane-services/api-keys/src/main/resources",
    resources = API_KEYS_RESOURCES,
    runtime_deps = [
        "@nv_third_party_deps//:com_jayway_jsonpath_json_path",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_jarmode_tools",
    ],
    visibility = ["//visibility:private"],
)

spring_boot_app(
    name = "app",
    application = ":app_classes",
    artifact_id = "nvcf-api-keys",
    artifact_name = "NVCF API Keys Service OSS",
    artifact_version = "0.0.1-SNAPSHOT",
    description = "NVIDIA API Keys Service OSS executable",
    group_id = "com.nvidia.apikeys",
    main_class = "com.nvidia.apikeys.App",
)

nvcf_java_test(
    name = "tests",
    srcs = API_KEYS_TEST_SRCS,
    deps = API_KEYS_DEPS + [
        ":app_classes",
        "//src/libraries/java/nv-boot-parent/nv-boot-mock-servers-test:nv_boot_mock_servers_test",
        "@nv_third_party_deps//:com_datastax_cassandra_cassandra_driver_core",
        "@nv_third_party_deps//:jakarta_servlet_jakarta_servlet_api",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_restclient",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_resttestclient",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_starter_webmvc_test",
        "@nv_third_party_deps//:org_springframework_boot_spring_boot_web_server",
        "@nv_third_party_deps//:org_testcontainers_testcontainers",
        "@nv_third_party_deps//:org_testcontainers_testcontainers_cassandra",
        "@nv_third_party_deps//:org_wiremock_wiremock_standalone",
    ],
    data = [":integration_local_env"],
    resource_strip_prefix = "src/control-plane-services/api-keys/src/test/resources",
    resources = API_KEYS_TEST_RESOURCES,
    size = "large",
    tags = [
        "exclusive",
        "external",
        "requires-docker",
    ],
    timeout = "long",
)

nvcf_java_coverage_test(
    name = "tests_coverage",
    coverage_target = ":app_classes",
    size = "large",
    tags = [
        "exclusive",
        "external",
        "requires-docker",
    ],
    test = ":tests",
    timeout = "long",
)

exports_files([
    "NOTICE",
    "notice_metadata.json",
])

nvcf_notice(
    checked_notice = ":NOTICE",
    first_party_groups = ["com.nvidia.apikeys"],
    inventory_name = "api_keys_runtime_inventory",
    metadata = ":notice_metadata.json",
    runtime_target = ":app",
    shared_metadata = [
        "//src/libraries/java/nv-boot-parent:notice_metadata.json",
    ],
)

nvcf_notice_delta(
    baseline_inventories = [
        "//src/libraries/java/nv-boot-parent:runtime_inventory.json",
    ],
    inventory = ":runtime_inventory.json",
)

# Multi-arch OCI image, the Bazel equivalent of this service's Dockerfile.
# jar_path, env and workdir mirror that Dockerfile exactly. The entrypoint comes
# from the shared macro, which keeps the base's shelless_ulimit shim that
# oci_image would otherwise silently replace.
java_oci_image(
    name = "api-keys-oss-image",
    jar = ":app",
    jar_path = "/usr/share/app.jar",
    env = {
        "ULIMIT_FLAG": "1",
        "JDK_JAVA_OPTIONS": "",
    },
    workdir = "/home/app",
)

# The shared guard every Java service uses, so the runtime contract cannot drift
# between services or between the architectures in the index.
java_image_contract_test(
    name = "image_contract_test",
    image = ":api-keys-oss-image",
    jar_path = "/usr/share/app.jar",
    env = {
        "ULIMIT_FLAG": "1",
        "JDK_JAVA_OPTIONS": "",
    },
    workdir = "/home/app",
)
