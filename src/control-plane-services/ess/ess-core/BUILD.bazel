nv_boot_library(
    name = "ess_core",
    srcs = ESS_CORE_SRCS,
    deps = ESS_CORE_DEPS,
    runtime_deps = [
        "@nv_third_party_deps//:io_projectreactor_reactor_tools",
        "@nv_third_party_deps//:net_logstash_logback_logstash_logback_encoder",
        "@nv_third_party_deps//:org_springdoc_springdoc_openapi_starter_webflux_ui",
    ],
)

ESS_CORE_TEST_DEPS = ESS_CORE_DEPS + [
    ":ess_core",
    "@nv_third_party_deps//:ch_qos_logback_logback_classic",
    "@nv_third_party_deps//:ch_qos_logback_logback_core",
    "@nv_third_party_deps//:io_projectreactor_reactor_test",
    "@nv_third_party_deps//:org_awaitility_awaitility",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_http_codec",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_jackson",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_security",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_starter_test",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_testcontainers",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_webflux",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_webflux_test",
    "@nv_third_party_deps//:org_springframework_boot_spring_boot_webtestclient",
    "@nv_third_party_deps//:org_testcontainers_testcontainers",
    "@nv_third_party_deps//:org_testcontainers_testcontainers_cassandra",
    "@nv_third_party_deps//:org_testcontainers_testcontainers_junit_jupiter",
    "@nv_third_party_deps//:org_wiremock_wiremock_standalone",
]

nv_boot_library_test(
    name = "unit_tests",
    coverage_library = ":ess_core",
    include_classname = ".*(Test|Tests)",
    javacopts = ["-Xep:ReturnValueIgnored:OFF"],
    resource_strip_prefix = "src/control-plane-services/ess/ess-core/src/test/resources",
    resources = ESS_CORE_TEST_RESOURCES,
    srcs = ESS_CORE_TEST_SRCS,
    deps = ESS_CORE_TEST_DEPS,
    timeout = "long",
)

nv_boot_library_test(
    name = "integration_tests",
    coverage_library = ":ess_core",
    data = [
        "//src/control-plane-services/ess:secrets_json",
        "//src/control-plane-services/ess:test_local_env",
    ],
    include_classname = ".*IT",
    javacopts = ["-Xep:ReturnValueIgnored:OFF"],
    jvm_flags = [
        "-Dnv-boot.reloadable-properties.file=file:$(location //src/control-plane-services/ess:secrets_json)",
        "-Dspring.main.web-application-type=reactive",
    ],
    resource_strip_prefix = "src/control-plane-services/ess/ess-core/src/test/resources",
    resources = ESS_CORE_TEST_RESOURCES,
    runtime_deps = [
        "//src/control-plane-services/ess:local_env_resources",
    ],
    size = "large",
    srcs = ESS_CORE_TEST_SRCS,
    tags = [
        "exclusive",
        "requires-docker",
    ],
    deps = ESS_CORE_TEST_DEPS,
    timeout = "long",
)
