<configuration debug="true">
  <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- %ex{3} limits exception stack traces to 3 lines -->
      <pattern>%d{ISO8601} [%thread] %-5level \(%t\) [%c{1}\(%M:%L\)] - %msg%n%ex{3}</pattern>
    </encoder>
  </appender>

  <!-- https://java.testcontainers.org/supported_docker_environment/logging_config/ -->
  <logger name="org.testcontainers" level="WARN"/>
  <!-- The following logger can be used for containers logs since 1.18.0 -->
  <logger name="tc" level="WARN"/>
  <logger name="com.github.dockerjava" level="WARN"/>
  <logger name="com.github.dockerjava.zerodep.shaded.org.apache.hc.client5.http.wire" level="OFF"/>
  <root level="warn">
    <appender-ref ref="stdout"/>
  </root>

</configuration>