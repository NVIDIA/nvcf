# Allowlist for GitLab -> GitHub copy.
# Same format as .gitignore; only paths matching a pattern below are copied.
#
# Intentionally omitted:
# - .gitlab-ci.yml          (internal CI only)
# - backend/bin/**           (compiled binaries)
# - backend/static/**        (built SPA output)
# - backend/vendor/**        (vendored Go deps; covered by root NOTICE)
# - ui/node_modules/**       (npm deps; not source)
# - ui/dist/**               (Vite build output)
# - ui/pnpm-lock.yaml        (lockfile; no license header needed)
# - ui/.aspect_rules_js/**   (Bazel-generated npm cache)
# - ui/vendor/**             (vendored third-party CSS; not NVIDIA-authored)

# OSS prep metadata
.oss-allowlist

# Root files
.gitignore
AGENTS.md
CLAUDE.md
NOTICE
THIRD-PARTY.txt
README.md
Taskfile.yml
license-header.txt

# Bazel scaffold
BUILD.bazel
**/BUILD.bazel
**/*.bzl

# Helm chart
helm/**

# OpenAPI specs
spec/**

# Go backend source
backend/go.mod
backend/go.sum
backend/.golangci.yml
backend/cmd/**
backend/internal/**

# UI source
ui/src/**
ui/scripts/**
ui/biome.json
ui/index.html
ui/orval.config.ts
ui/tsconfig.json
ui/vite.config.ts
ui/vitest.setup.ts
ui/package.json
ui/Taskfile.yml
ui/BUILD.bazel
ui/pnpm-workspace.yaml
