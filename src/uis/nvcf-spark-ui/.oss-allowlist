# Allowlist for GitLab -> GitHub copy.
# Same format as .gitignore; only paths matching a pattern below are copied.
#
# Intentionally omitted:
# - backend/bin/**                 (compiled binaries and image tarballs)
# - backend/static/**              (built SPA output)
# - ui/node_modules/**             (npm deps; not source)
# - ui/dist/**, ui/coverage/**, ui/test-results/**, ui/playwright-report/**
#                                  (build and test output)
# - ui/pnpm-lock.yaml              (lockfile; no license header needed)
# - ui/.aspect_rules_js/**         (Bazel-generated npm cache)
# - ui/public/mockServiceWorker.js (generated by MSW; not NVIDIA-authored)
# - ui/vendor/**                   (vendored third-party CSS and fonts; not NVIDIA-authored)

# OSS prep metadata
.oss-allowlist

# Root files
.dockerignore
.gitignore
.redocly.lint-ignore.yaml
Dockerfile
Makefile
README.md
license-header.txt
redocly.yaml

# Bazel scaffold
BUILD.bazel
**/BUILD.bazel
**/*.bzl

# Helm chart
helm/**

# OpenAPI specs
spec/**

# Go backend source
backend/.gitignore
backend/.golangci.yml
backend/go.mod
backend/go.sum
backend/cmd/**
backend/internal/**

# UI source
ui/.gitignore
ui/src/**
ui/scripts/**
ui/e2e/**
ui/public/favicon.ico
ui/biome.json
ui/index.html
ui/orval.config.ts
ui/playwright.config.ts
ui/playwright.prod.config.ts
ui/tsconfig.json
ui/vite.config.ts
ui/vitest.setup.ts
ui/package.json
ui/pnpm-workspace.yaml
