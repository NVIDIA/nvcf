load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "server_lib",
    srcs = [
        "config.go",
        "gateway.go",
        "main.go",
        "recipes.go",
    ],
    importpath = "github.com/NVIDIA/nvcf/src/uis/nvcf-spark-ui/backend/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//src/uis/nvcf-spark-ui/backend/internal/middleware",
        "//src/uis/nvcf-spark-ui/backend/internal/utils",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//hlog",
        "@io_k8s_sigs_controller_runtime//pkg/manager/signals",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = [
        "config_test.go",
        "gateway_test.go",
        "main_test.go",
        "recipes_test.go",
        "spec_test.go",
    ],
    # spec_test.go validates responses against the BFF's own spec; recipes_test.go
    # reads the recipe catalog fixture.
    data = [
        "testdata/recipes.json",
        "//src/uis/nvcf-spark-ui/spec:bff-openapi.yaml",
    ],
    embed = [":server_lib"],
    deps = [
        "//src/uis/nvcf-spark-ui/backend/internal/middleware",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(
        [
            "*.go",
            "*.md",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
