load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "statickeys",
    srcs = ["statickeys.go"],
    importpath = "github.com/NVIDIA/nvcf/src/invocation-plane-services/llm-gateway/auth/statickeys",
    visibility = ["//visibility:public"],
    deps = [
        "//src/invocation-plane-services/llm-api-gateway/nvcf",
        "//src/invocation-plane-services/llm-api-gateway/telemetry",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

alias(
    name = "go_default_library",
    actual = ":statickeys",
    visibility = ["//visibility:public"],
)

go_test(
    name = "statickeys_test",
    srcs = ["statickeys_test.go"],
    embed = [":statickeys"],
    deps = [
        "@com_github_rs_zerolog//:zerolog",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
