load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tlsreload",
    srcs = ["tlsreload.go"],
    importpath = "github.com/NVIDIA/nvcf/src/invocation-plane-services/llm-gateway/internal/tlsreload",
    visibility = ["//src/invocation-plane-services/llm-api-gateway:__subpackages__"],
    deps = [
        "//src/invocation-plane-services/llm-api-gateway/telemetry",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

alias(
    name = "go_default_library",
    actual = ":tlsreload",
    visibility = ["//src/invocation-plane-services/llm-api-gateway:__subpackages__"],
)

go_test(
    name = "tlsreload_test",
    srcs = ["tlsreload_test.go"],
    embed = [":tlsreload"],
    deps = [
        "@com_github_rs_zerolog//:zerolog",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
