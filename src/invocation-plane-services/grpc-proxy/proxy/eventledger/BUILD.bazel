load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "eventledger",
    srcs = [
        "auth.go",
        "eventledger.go",
    ],
    importpath = "nvcf-grpc-proxy/proxy/eventledger",
    visibility = ["//visibility:public"],
    deps = [
        "//src/invocation-plane-services/grpc-proxy/proxy/credentials",
        "//src/invocation-plane-services/grpc-proxy/proxy/metrics",
        "//src/libraries/go/lib/pkg/nvkit/auth",
        "//src/libraries/go/lib/pkg/nvkit/clients",
        "@com_github_cenkalti_backoff_v4//:backoff",
        "@com_github_cloudevents_sdk_go_v2//:sdk-go",
        "@com_github_cloudevents_sdk_go_v2//protocol/http",
        "@org_uber_go_zap//:zap",
    ],
)

alias(
    name = "go_default_library",
    actual = ":eventledger",
    visibility = ["//visibility:public"],
)

go_test(
    name = "eventledger_test",
    srcs = ["eventledger_test.go"],
    embed = [":eventledger"],
    deps = [
        "//src/invocation-plane-services/grpc-proxy/proxy/metrics",
        "@com_github_cloudevents_sdk_go_v2//:sdk-go",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/testutil",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
