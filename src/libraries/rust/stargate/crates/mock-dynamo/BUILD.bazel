load("@rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@stargate_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//rules/oci:defs.bzl", "rust_oci_image")

# Workspace-local Cargo deps (own-workspace `workspace = true`).
_WORKSPACE_DEPS = [
    "//src/libraries/rust/stargate/crates/mock-engine",
]

rust_binary(
    name = "mock-dynamo",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "mock-dynamo_test",
    crate = ":mock-dynamo",
    deps = _WORKSPACE_DEPS + all_crate_deps(normal_dev = True),
)

rust_oci_image(
    name = "image",
    base = "@distroless_cc",
    binary = ":mock-dynamo",
    binary_path = "/usr/local/bin/mock-dynamo",
    tags = ["mock-dynamo"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "image_entrypoint_mode_test",
    srcs = ["//src/libraries/rust/stargate/tools/ci:image_entrypoint_mode_test.sh"],
    args = [
        "$(location :image_layer)",
        "/usr/local/bin/mock-dynamo",
    ],
    data = [":image_layer"],
)

go_test(
    name = "image_numeric_user_test",
    srcs = ["//rules/oci/private:numeric_user_test.go"],
    args = [
        "-image_index=$(location :image_index)",
        "-expected_user=1000:1000",
    ],
    data = [":image_index"],
)
