load("@stargate_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Use the repository protoc toolchain for protobuf code generation.
cargo_build_script(
    name = "build_script",
    edition = "2024",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    build_script_env = {
        "PROTOC": "$(execpath @com_google_protobuf//:protoc)",
        # cargo_build_script runs from _main/crates/proto/, so the
        # well-known-type include dir resolves via three parent hops.
        "PROTOC_WKT_DIR": "../../../../../../../protobuf+/src",
    },
    data = glob(["proto/**/*.proto"]) + [
        "@com_google_protobuf//:well_known_type_protos",
    ],
    tools = [
        "@com_google_protobuf//:protoc",
    ],
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "stargate-proto",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "stargate_proto",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = [":build_script"] + all_crate_deps(normal = True),
)

rust_test(
    name = "stargate-proto_test",
    crate = ":stargate-proto",
    deps = all_crate_deps(normal_dev = True),
)
