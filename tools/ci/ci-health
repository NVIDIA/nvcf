{fam_rows}</table>
{"<p class='sub' style='margin:12px 0 0'>" + f"{cache['stranded']:.2f} GB is stored on <code>gh-readonly-queue</code> refs. Those branches are deleted when the merge queue drains, so the entries can never be restored but still count against quota." + "</p>" if cache["stranded"] else ""}
