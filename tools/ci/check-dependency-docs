# check-dependency-docs — verify generated dependency markdown is up to date.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "${repo_root}"

checked_in="$(mktemp "${TMPDIR:-/tmp}/dependencies.md.XXXXXX")"
trap 'rm -f "${checked_in}"' EXIT
cp dependencies.md "${checked_in}"

GOWORK=off go run -C ./tools/collect-dependencies .

if ! cmp -s "${checked_in}" dependencies.md; then
  echo "dependencies.md is stale; regenerate and commit it." >&2
  diff -u "${checked_in}" dependencies.md || true
  exit 1
fi

echo "dependencies.md is up to date."
