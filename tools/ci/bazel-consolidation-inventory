#
# Regenerates the measurements quoted in docs/dev/bazel-consolidation.md.
#
# The plan quotes live counts, and those move: an in-flight change to pin the
# worker Bazel versions invalidated part of the first draft within hours of it
# being written. Run this instead of trusting the prose, and update the doc plus
# its measurement stamp when the numbers move.
#
# Why Python rather than shell. An earlier version of this tool was a bash
# script, and review found the same class of defect in it repeatedly: a failed
# `git` call, a broken `grep` selector, an unreadable file, or a legitimate
# no-match would each be converted into a plausible zero or a silent abort,
# because shell reports failure through exit statuses that are easy to discard
# and hard to distinguish from "found nothing". A tool whose purpose is to make
# quoted numbers reproducible must never answer confidently when it could not
# compute the answer. Here a failure raises, and no report is printed; there is
# no path that emits a partial or default-valued report.
#
# Two distinctions the tool is built around, because collapsing either one
# produced a real defect:
#   - Absent is not the same as unparseable. Zero sources reports "none"; a
#     source that exists but yields nothing is an error.
#   - A clean tree is not the same as an unknown tree. Measurements come from
#     working-tree contents of git-tracked files, so the tree must be clean for
#     the output to correspond to the stamped commit.
#
# Usage: bazel-consolidation-inventory [--allow-dirty] [repo-root]

import argparse
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

VENDOR_RE = re.compile(r"(^|/)vendor/")
SERVICE_MODULE_RE = re.compile(r"^src/.*/MODULE\.bazel$")
MODULE_RE = re.compile(r"(^|/)MODULE\.bazel$")
LOCK_RE = re.compile(r"(^|/)MODULE\.bazel\.lock$")
BAZELRC_RE = re.compile(r"^src/.*/\.bazelrc$")
BAZELVERSION_RE = re.compile(r"^src/.*/\.bazelversion$")
WORKSPACE_STATUS_RE = re.compile(r"(^|/)workspace_status\.sh$")
RULES_OCI_RE = re.compile(r"(^|/)rules/oci/")
BUILD_RE = re.compile(r"(^|/)BUILD\.bazel$")
NVCA_VENDOR_BUILD_RE = re.compile(
    r"^src/compute-plane-services/nvca/vendor/.*/BUILD\.bazel$"
)

GO_SDK_BLOCK_RE = re.compile(r"go_sdk\.download\((.*?)\)", re.S)
GO_SDK_CALL_RE = re.compile(r"go_sdk\.download\(")
SEMVER_RE = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
OCI_PULL_RE = re.compile(r"oci\.pull\((.*?)\n\)", re.S)
IMAGE_RE = re.compile(r"image\s*=\s*\"([^\"]+)\"")
DIGEST_RE = re.compile(r"digest\s*=\s*\"(sha256:[0-9a-f]+)\"")
VERSION_LINE_RE = re.compile(r"^[0-9]")


class InventoryError(Exception):
    """A measurement could not be taken. No report is printed."""


def git(root, *args):
    """Run git, raising on failure rather than yielding an empty result.

    A failed `git ls-files` returning empty output is indistinguishable from a
    repository with no tracked files, and every count downstream would then
    report a plausible zero.
    """
    result = subprocess.run(
        ["git", *args], cwd=root, capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        raise InventoryError(
            f"git {' '.join(args)} failed with status {result.returncode}: "
            f"{result.stderr.strip() or 'no stderr'}"
        )
    return result.stdout


class Tree:
    """The git-tracked files of one repository, and their contents."""

    def __init__(self, root, allow_dirty=False):
        self.root = Path(root).resolve()
        self.head = git(self.root, "rev-parse", "--short", "HEAD").strip()
        self.date = git(self.root, "log", "-1", "--format=%cs").strip()

        self.dirty = bool(git(self.root, "status", "--porcelain").strip())
        if self.dirty and not allow_dirty:
            raise InventoryError(
                f"working tree is dirty, so measurements would not match commit "
                f"{self.head}.\n"
                "       Commit or stash your changes, or pass --allow-dirty to "
                "measure anyway."
            )

        self.paths = [p for p in git(self.root, "ls-files", "-z").split("\0") if p]
        self._contents = {}

    def select(self, pattern, include_vendor=False):
        """Tracked paths matching pattern, sorted for deterministic output."""
        return sorted(
            p
            for p in self.paths
            if pattern.search(p) and (include_vendor or not VENDOR_RE.search(p))
        )

    def read(self, path):
        """Read a tracked file, raising if it cannot be read.

        A tracked file that is missing or unreadable would otherwise make a
        count silently low, which is worse than no answer at all.
        """
        if path not in self._contents:
            try:
                self._contents[path] = (self.root / path).read_text(
                    encoding="utf-8", errors="replace"
                )
            except OSError as exc:
                raise InventoryError(f"cannot read tracked file {path}: {exc}") from exc
        return self._contents[path]

    def occurrences(self, paths, needle):
        """Count lines containing needle across paths."""
        return sum(
            1
            for path in paths
            for line in self.read(path).splitlines()
            if needle in line
        )

    def distinct(self, paths):
        return len({self.read(p) for p in paths})


def version_key(value):
    return tuple(int(part) for part in re.findall(r"[0-9]+", value))


def bazel_versions(tree):
    """Distribution of subtree Bazel versions.

    Zero subtree files is the intended post-consolidation state and reports
    "none". A file that exists but yields no version is malformed and is an
    error, not an absence: reporting it as "none" would announce the plan's
    success condition on the strength of a parse failure.
    """
    paths = tree.select(BAZELVERSION_RE)
    if not paths:
        return "none (all subtrees use the root version)"

    versions = []
    for path in paths:
        matched = [
            line.strip()
            for line in tree.read(path).splitlines()
            if VERSION_LINE_RE.match(line.strip())
        ]
        if len(matched) != 1:
            raise InventoryError(
                f"{path} yielded {len(matched)} version line(s), expected exactly "
                "1; the file is empty or malformed"
            )
        versions.append(matched[0])

    counts = Counter(versions)
    ordered = sorted(counts.items(), key=lambda kv: version_key(kv[0]))
    return "  ".join(f"{count} on {version}" for version, count in ordered) + "  "


def go_sdk_versions(tree, include_vendor, label):
    """Go SDK versions, distinguishing absence from an unparsed declaration."""
    paths = tree.select(MODULE_RE, include_vendor=include_vendor)
    declarations = sum(len(GO_SDK_CALL_RE.findall(tree.read(p))) for p in paths)
    if declarations == 0:
        return "none"

    versions = []
    for path in paths:
        for block in GO_SDK_BLOCK_RE.findall(tree.read(path)):
            found = SEMVER_RE.findall(block)
            if len(found) != 1:
                raise InventoryError(
                    f"{path} contains a {label} go_sdk.download yielding "
                    f"{len(found)} version(s), expected exactly 1; the "
                    "declaration form is not understood by this parser"
                )
            versions.append(found[0])

    if len(versions) != declarations:
        raise InventoryError(
            f"{declarations} {label} go_sdk.download declaration(s) yielded "
            f"{len(versions)} version(s); the declaration form is not understood"
        )
    return " ".join(sorted(set(versions), key=version_key)) + " "


def oci_pulls(tree):
    """oci.pull declarations, distinct images, digests, and tag-only pulls."""
    declarations = 0
    from_nvcr = 0
    images = set()
    digests = set()
    tag_only = []
    for path in tree.select(MODULE_RE):
        for body in OCI_PULL_RE.findall(tree.read(path)):
            image = IMAGE_RE.search(body)
            if not image:
                continue
            declarations += 1
            images.add(image.group(1))
            if image.group(1).startswith("nvcr.io/"):
                from_nvcr += 1
            digest = DIGEST_RE.search(body)
            if digest:
                digests.add(digest.group(1))
            else:
                tag_only.append(image.group(1))
    return {
        "declarations": declarations,
        "from_nvcr": from_nvcr,
        "images": len(images),
        "digests": len(digests),
        "tag_only": sorted(tag_only),
    }


def build_report(tree):
    """Compute every measurement, then format. Nothing is printed on failure."""
    service_modules = tree.select(SERVICE_MODULE_RE)
    all_modules = tree.select(MODULE_RE, include_vendor=True)
    locks = tree.select(LOCK_RE, include_vendor=True)
    bazelrcs = tree.select(BAZELRC_RE)
    workspace_status = tree.select(WORKSPACE_STATUS_RE, include_vendor=True)
    oci_files = tree.select(RULES_OCI_RE)
    build_files = tree.select(BUILD_RE)
    nvca_vendored = tree.select(NVCA_VENDOR_BUILD_RE, include_vendor=True)

    lock_mb = sum(len(tree.read(p).encode("utf-8")) for p in locks) / 1048576
    oci_lines = sum(len(tree.read(p).splitlines()) for p in oci_files)
    pulls = oci_pulls(tree)

    stamp = tree.head
    if tree.dirty:
        stamp += f"  (WORKING TREE, not {tree.head}: --allow-dirty was passed)"

    return "\n".join(
        [
            f"measured at: {stamp}",
            f"date:        {tree.date}",
            "",
            f"service modules (src, excluding vendor) : {len(service_modules)}",
            f"MODULE.bazel total (incl. root/helpers) : {len(all_modules)}",
            f"MODULE.bazel.lock files                 : {len(locks)}",
            f"MODULE.bazel.lock total size            : {lock_mb:.1f} MB",
            "",
            f"subtree .bazelrc                        : {len(bazelrcs)} "
            f"({tree.distinct(bazelrcs)} distinct)",
            f"subtree .bazelversion values            : {bazel_versions(tree)}",
            f"workspace_status.sh copies              : {len(workspace_status)} "
            f"({tree.distinct(workspace_status)} variants)",
            f"rules/oci copied files                  : {len(oci_files)} files, "
            f"{oci_lines} lines",
            "",
            "root-relative //:__subpackages__         : "
            f"{tree.occurrences(build_files, '//:__subpackages__')}",
            "//visibility:public (outside vendor)    : "
            f"{tree.occurrences(build_files, '//visibility:public')}",
            "package_group definitions               : "
            f"{tree.occurrences(build_files, 'package_group(')}",
            f"nvca vendored BUILD.bazel               : {len(nvca_vendored)}",
            "",
            "go_sdk.download (first-party)           : "
            f"{go_sdk_versions(tree, False, 'first-party')}",
            "go_sdk.download (incl. vendored)        : "
            f"{go_sdk_versions(tree, True, 'vendored-inclusive')}",
            f"oci.pull declarations                   : {pulls['declarations']} "
            f"({pulls['from_nvcr']} from nvcr.io)",
            f"oci.pull distinct images / digests      : {pulls['images']} images, "
            f"{pulls['digests']} digests",
            f"oci.pull without a digest (tag-only)    : {len(pulls['tag_only'])} "
            f"({','.join(pulls['tag_only']) or '-'})",
        ]
    )


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Regenerate the measurements quoted in "
        "docs/dev/bazel-consolidation.md."
    )
    parser.add_argument(
        "repo_root",
        nargs="?",
        default=None,
        help="repository to measure (default: the repository containing this tool)",
    )
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="measure a dirty tree; the stamp then says so explicitly",
    )
    args = parser.parse_args(argv)

    root = args.repo_root or Path(__file__).resolve().parents[2]
    try:
        report = build_report(Tree(root, allow_dirty=args.allow_dirty))
    except InventoryError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
