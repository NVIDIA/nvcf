#
# Thin wrapper around the Go implementation in
# tools/bazel-consolidation-inventory, so the documented command stays stable.
# See that directory for the tool itself and its tests.
#
# The tool is its own Go module and there is no module at the repository root,
# so `go run` is invoked from the tool's directory and the repository being
# measured is passed as an absolute path.
#
# Usage: tools/ci/bazel-consolidation-inventory [--allow-dirty] [repo-root]
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

flags=()
target=""
for arg in "$@"; do
  case "${arg}" in
    -*) flags+=("${arg}") ;;
    *)  target="${arg}" ;;
  esac
done
target="$(cd "${target:-${repo_root}}" && pwd)"

cd "${repo_root}/tools/bazel-consolidation-inventory"
exec go run . ${flags[@]+"${flags[@]}"} "${target}"
