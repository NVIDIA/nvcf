set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

require_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    return 0
  fi

  if command -v apk >/dev/null 2>&1; then
    apk add -q "$1"
    return 0
  fi

  echo "Missing required command: $1" >&2
  exit 1
}

require_cmd curl
require_cmd jq

# Candidate configuration is applied only inside a disposable clone. Git history
# and the real origin remain available for Fern's branch-ref resolver.
preview_workspace=""
preview_log="$(mktemp)"
cleanup() {
  rm -f "$preview_log"
  if [ -n "$preview_workspace" ]; then
    rm -rf "$preview_workspace"
  fi
}
trap cleanup EXIT
if [ -n "${DOCS_PREVIEW_CONFIG:-}" ]; then
  if ! [[ "$DOCS_PREVIEW_CONFIG" =~ ^fern/[A-Za-z0-9._-]+\.ya?ml$ ]] || [ ! -f "$DOCS_PREVIEW_CONFIG" ]; then
    echo "DOCS_PREVIEW_CONFIG must name an existing YAML file directly under fern/." >&2
    exit 1
  fi
  preview_workspace="$(mktemp -d)"
  git clone --quiet --shared --no-checkout "$repo_root" "$preview_workspace/source"
  git -C "$preview_workspace/source" remote set-url origin "$(git remote get-url origin)"
  cp -R docs fern "$preview_workspace/source/"
  cp "$DOCS_PREVIEW_CONFIG" "$preview_workspace/source/fern/docs.yml"
  if [ "$DOCS_PREVIEW_CONFIG" = fern/edition-preview.yml ]; then
    go run -C "$repo_root/tools/docs-version-sync" . edition links --repo "$preview_workspace/source"
  fi
  cd "$preview_workspace/source"
fi

project_name="${CI_PROJECT_NAME:-}"
mr_iid="${CI_MERGE_REQUEST_IID:-}"
mr_project_id="${CI_MERGE_REQUEST_PROJECT_ID:-}"
preview_id="${DOCS_PREVIEW_ID:-}"

if [ -z "${preview_id}" ]; then
  if [ -z "${project_name}" ] || [ -z "${mr_iid}" ]; then
    echo "Set DOCS_PREVIEW_ID, or provide CI_PROJECT_NAME and CI_MERGE_REQUEST_IID." >&2
    exit 1
  fi
  preview_id="${project_name}-mr-${mr_iid}"
fi

"$repo_root/tools/ci/run-fern" generate --docs --preview --id "${preview_id}" --force --strict-broken-links 2>&1 | tee "$preview_log"
preview_url="$(grep -oE -m1 '(https://[^[:space:]]+-preview-[^[:space:]]+)' "$preview_log" | sed 's/[[:space:]()]$//' || true)"
echo "Preview URL: ${preview_url}"

if [ -z "${preview_url}" ]; then
  echo "No preview URL found" >&2
  exit 1
fi

if [ "${DOCS_PREVIEW_SKIP_COMMENT:-}" = "1" ]; then
  exit 0
fi

if [ -z "${mr_project_id}" ] || [ -z "${mr_iid}" ] || [ -z "${FERN_BOT:-}" ]; then
  echo "Skipping MR comment: set CI_MERGE_REQUEST_PROJECT_ID, CI_MERGE_REQUEST_IID, and FERN_BOT to post it." >&2
  exit 0
fi

gitlab_api_url="${DOCS_PREVIEW_GITLAB_API_URL:-${CI_API_V4_URL:-}}"
if [ -z "${gitlab_api_url}" ]; then
  echo "Skipping MR comment: set DOCS_PREVIEW_GITLAB_API_URL or CI_API_V4_URL to post it." >&2
  exit 0
fi
gitlab_api_url="${gitlab_api_url%/}"

if ! curl --silent --fail --location \
  --header "PRIVATE-TOKEN: ${FERN_BOT}" \
  --header "Content-Type: application/json" \
  --url "${gitlab_api_url}/projects/${mr_project_id}/merge_requests/${mr_iid}/notes" \
  --data-raw "{ \"body\": \"Preview your docs at ${preview_url}\" }"; then
  echo "Skipping MR comment: GitLab API request failed." >&2
fi
