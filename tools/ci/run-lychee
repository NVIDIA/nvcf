set -euo pipefail
version=0.24.2
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    platform=x86_64-unknown-linux-musl
    checksum=73657a111819a30c47c08352896796f23d64e4eb2b3ed39b6d32149241566fc5
    ;;
  Darwin-arm64)
    platform=aarch64-apple-darwin
    checksum=c9d3740ea2d891854d37116c9fba840f37b6e7c89d330e7db84ac333631c4977
    ;;
  *) echo 'run-lychee supports Linux x86_64 and macOS arm64.' >&2; exit 2 ;;
esac
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
archive="$workdir/lychee.tar.gz"
curl --fail --silent --show-error --location --retry 3 --connect-timeout 10 --max-time 120 \
  "https://github.com/lycheeverse/lychee/releases/download/lychee-v${version}/lychee-${platform}.tar.gz" \
  --output "$archive"
if command -v sha256sum > /dev/null; then
  actual="$(sha256sum "$archive")"
else
  actual="$(shasum -a 256 "$archive")"
fi
if [ "${actual%% *}" != "$checksum" ]; then
  echo 'Lychee archive checksum mismatch.' >&2
  exit 1
fi
tar -xzf "$archive" -C "$workdir" --strip-components=1
"$workdir/lychee" "$@"
