#
# Lint, render, and validate a package for every chart that has a CI values file.
#
# tools/ci/helm-validate-values/<name>.yaml holds the CI-only values for one
# chart. The chart directory is not derivable from the file name, so the
# mapping is spelled out in chart_map below. Both directions are checked: a
# values file with no entry fails, and an entry whose chart directory is gone
# fails. Otherwise a new values file could land with nothing validating it.
#
# Every chart runs even after one fails, so a single run reports every broken
# chart instead of only the first.
#
# Usage:
#   tools/ci/check-helm-charts
#   tools/ci/check-helm-charts --values-dir DIR --chart-root DIR
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/../.." && pwd)"
values_dir="${repo_root}/tools/ci/helm-validate-values"
chart_root="${repo_root}/deploy/helm"
package_roots=("${chart_root}" "${repo_root}/deploy/stacks" "${repo_root}/src/uis")

while [ $# -gt 0 ]; do
    case "$1" in
        --values-dir) values_dir="$2"; shift 2 ;;
        --chart-root) chart_root="$2"; package_roots=("$2"); shift 2 ;;
        -h|--help)
            echo "usage: check-helm-charts [--values-dir DIR] [--chart-root DIR]"
            exit 0
            ;;
        *) echo "check-helm-charts: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

# "<values file stem> <chart directory relative to deploy/helm>"
chart_map=(
    "admin-token-issuer-proxy admin-token-issuer-proxy/chart"
    "api-keys-colocated       api-keys-colocated/api-keys"
    "cassandra                cassandra/helm"
    "cloud-functions          cloud-functions/nvcf-api"
    "container-cache          container-cache/deploy"
    "ess                      encrypted-secret-store/ess-api"
    "function-autoscaler      function-autoscaler"
    "gateway-routes-vanity    gateway-routes/chart"
    "grpc-proxy               grpc-proxy/grpc-proxy"
    "helm-reval               helm-reval"
    "http-invocation          http-invocation/nvcf-invocation-service"
    "icms                     icms/icms-api"
    "llm-api-gateway          llm-api-gateway/llm-api-gateway"
    "llm-request-router       llm-request-router/llm-request-router"
    "notary                   notary/nvcf-notary-service"
    "nvca-operator            nvca-operator/nvca-operator"
    "openbao                  openbao/helm"
    "ratelimiter              ratelimiter/nvcf-ratelimiter"
    "vanity-gateway           vanity-gateway/helm-nvcf-vanity-gateway"
)

chart_for() {  # chart_for <values stem> -> chart directory relative to chart_root
    local stem="$1" entry
    for entry in "${chart_map[@]}"; do
        if [ "${entry%% *}" = "${stem}" ]; then
            printf '%s' "${entry##* }"
            return 0
        fi
    done
    return 1
}

# ---------------------------------------------------------------------------
# Wiring: every values file maps to a chart, and every mapping is still live.
# ---------------------------------------------------------------------------

if [ ! -d "${values_dir}" ]; then
    echo "check-helm-charts: values directory not found: ${values_dir}" >&2
    exit 1
fi

stems=()
while IFS= read -r path; do
    stems+=("$(basename "${path}" .yaml)")
done < <(find "${values_dir}" -maxdepth 1 -type f -name '*.yaml' | sort)

if [ "${#stems[@]}" -eq 0 ]; then
    echo "check-helm-charts: no values files in ${values_dir}" >&2
    exit 1
fi

wiring_errors=0

for stem in "${stems[@]}"; do
    if ! chart_for "${stem}" >/dev/null; then
        echo "check-helm-charts: ${stem}.yaml has no chart mapping." >&2
        echo "  Add \"${stem} <chart dir under deploy/helm>\" to chart_map in ${BASH_SOURCE[0]}." >&2
        wiring_errors=1
    fi
done

for entry in "${chart_map[@]}"; do
    stem="${entry%% *}"
    chart_dir="${chart_root}/${entry##* }"
    if [ ! -f "${values_dir}/${stem}.yaml" ]; then
        echo "check-helm-charts: chart_map entry '${stem}' has no ${values_dir}/${stem}.yaml." >&2
        echo "  Remove the stale entry or restore the values file." >&2
        wiring_errors=1
    fi
    if [ ! -f "${chart_dir}/Chart.yaml" ]; then
        echo "check-helm-charts: chart_map entry '${stem}' points at ${chart_dir}, which has no Chart.yaml." >&2
        echo "  Update the entry to the chart's current directory." >&2
        wiring_errors=1
    fi
done

if [ "${wiring_errors}" -ne 0 ]; then
    exit 1
fi

# ---------------------------------------------------------------------------
# Lint, render, and validate packages.
# ---------------------------------------------------------------------------

if ! command -v helm >/dev/null 2>&1; then
    echo "check-helm-charts: 'helm' not found on PATH." >&2
    echo "  Install helm v3.x from https://helm.sh/docs/intro/install/." >&2
    exit 1
fi

# Build dependencies and packages in copies. Helm may create Chart.lock or
# replace an existing dependency archive; neither should mutate the source tree.
package_work="$(mktemp -d)"
trap 'rm -rf "${package_work}"' EXIT
export HELM_REPOSITORY_CONFIG="${package_work}/helm/repositories.yaml"
export HELM_REPOSITORY_CACHE="${package_work}/helm/cache"
export HELM_REGISTRY_CONFIG="${package_work}/helm/registry.json"
mkdir -p "${HELM_REPOSITORY_CACHE}"

copy_chart() {
    local source="$1" destination="$2"
    mkdir -p "${destination}" || return 1
    cp -R "${source}/." "${destination}/"
}

if ! command -v go >/dev/null 2>&1; then
    echo "check-helm-charts: Go is required to build tools/chart-artifact." >&2
    exit 1
fi
go build -C "${repo_root}/tools/chart-artifact" -o "${package_work}/chart-artifact" .

package_and_check() {
    local stem="$1" chart_dir="$2" output_dir="${package_work}/$1"
    mkdir -p "${output_dir}"
    helm package "${chart_dir}" --destination "${output_dir}" || return 1
    local packages=("${output_dir}"/*.tgz)
    if [[ ${#packages[@]} -ne 1 || ! -f "${packages[0]}" ]]; then
        echo "${stem}: helm package must produce exactly one archive" >&2
        return 1
    fi
    "${package_work}/chart-artifact" validate --metadata "${chart_dir}/Chart.yaml" "${packages[0]}"
}

run_step() {  # run_step <label> <command...> -> 0 on success, prints output on failure
    local label="$1"; shift
    local output status=0
    output="$("$@" 2>&1)" || status=$?
    if [ "${status}" -ne 0 ]; then
        printf 'FAIL %s\n' "${label}"
        printf '%s\n' "${output}" | sed 's/^/     /'
        return 1
    fi
    return 0
}

# helm template and helm lint accept a document whose apiVersion has been
# swallowed into a preceding comment (a template action ending in "-}}" right
# after the license header does this), because the line is valid YAML. The
# API server and ArgoCD then reject the object ("groupVersion shouldn't be
# empty"). Check every rendered document for a top-level apiVersion and kind.
check_rendered_objects() {  # check_rendered_objects <stem> <rendered file>
    local stem="$1" rendered="$2"
    # Document-aware: a comment that merely mentions "kind:" is fine. Only when
    # the same document lacks the top-level field is the comment line reported,
    # as the likely place the field was trimmed onto.
    awk -v stem="${stem}" '
        function flush() {
            if (content) {
                if (!hasapi) report("apiVersion", gluedapi)
                if (!haskind) report("kind", gluedkind)
            }
            content = 0; hasapi = 0; haskind = 0; gluedapi = 0; gluedkind = 0; name = "?"; n++
        }
        function report(field, glued) {
            bad++
            if (glued) {
                printf "%s: rendered document %d (%s) has no top-level %s; line %d has %s rendered onto a comment line (a template action ending in -}} trimmed the newline)\n", stem, n, name, field, glued, field > "/dev/stderr"
            } else {
                printf "%s: rendered document %d (%s) has no top-level %s\n", stem, n, name, field > "/dev/stderr"
            }
        }
        BEGIN { n = 1; name = "?" }
        /^---/ { flush(); next }
        /^[ \t]*#/ {
            if ($0 ~ /apiVersion:/ && !gluedapi) gluedapi = NR
            if ($0 ~ /kind:/ && !gluedkind) gluedkind = NR
            next
        }
        /^[ \t]*$/ { next }
        { content = 1 }
        /^apiVersion:/ { hasapi = 1 }
        /^kind:/ { haskind = 1 }
        /^  name:/ && name == "?" { name = $2 }
        END {
            flush()
            exit (bad ? 1 : 0)
        }
    ' "${rendered}"
}

render_and_check() {  # render_and_check <stem> <chart dir> <values file>
    local stem="$1" chart_dir="$2" values_file="$3" rendered
    rendered="$(mktemp)"
    if ! helm template "${stem}" "${chart_dir}" -f "${values_file}" >"${rendered}"; then
        rm -f "${rendered}"
        return 1
    fi
    check_rendered_objects "${stem}" "${rendered}"
    local rc=$?
    rm -f "${rendered}"
    return "${rc}"
}

prepare_dependencies() {
    local chart_dir="$1" stem="$2"
    if grep -qE '^dependencies:' "${chart_dir}/Chart.yaml"; then
        local repositories repo_name repo_url
        repositories="$("${package_work}/chart-artifact" repositories "${chart_dir}/Chart.yaml")" || return 1
        while read -r repo_name repo_url; do
            [[ -n "${repo_name}" ]] || continue
            run_step "${stem}: helm repo add" helm repo add "${repo_name}" "${repo_url}" --force-update || return 1
        done <<<"${repositories}"
        run_step "${stem}: helm dependency build" helm dependency build "${chart_dir}" || return 1
    fi
}

failed=()
packaged=()

for stem in "${stems[@]}"; do
    source_chart_dir="${chart_root}/$(chart_for "${stem}")"
    chart_dir="${package_work}/sources/${stem}"
    copy_chart "${source_chart_dir}" "${chart_dir}"
    values_file="${values_dir}/${stem}.yaml"
    chart_failed=0

    prepare_dependencies "${chart_dir}" "${stem}" || chart_failed=1

    if [ "${chart_failed}" -eq 0 ]; then
        run_step "${stem}: helm lint" \
            helm lint "${chart_dir}" -f "${values_file}" || chart_failed=1
        run_step "${stem}: helm template" \
            render_and_check "${stem}" "${chart_dir}" "${values_file}" || chart_failed=1
        run_step "${stem}: chart package validation" \
            package_and_check "${stem}" "${chart_dir}" || chart_failed=1
    fi

    if [ "${chart_failed}" -eq 0 ]; then
        packaged+=("${source_chart_dir}")
        printf 'ok   %s (%s)\n' "${stem}" "$(chart_for "${stem}")"
    else
        failed+=("${stem}")
    fi
done

# Package every source chart in publication scopes, including charts that do not
# need CI render values. Chart.yaml is authoritative; nested dependency charts
# are included in the parent package rather than checked as separate releases.
"${package_work}/chart-artifact" discover "${package_roots[@]}" >"${package_work}/chart-roots"
extra_index=0
while IFS= read -r chart_dir; do
    already_checked=0
    for checked in "${packaged[@]}"; do
        if [[ "${checked}" == "${chart_dir}" ]]; then already_checked=1; break; fi
    done
    [[ ${already_checked} -eq 0 ]] || continue
    stem="${chart_dir#"${repo_root}/"}"
    extra_index=$((extra_index + 1))
    source_copy="${package_work}/sources/extra-${extra_index}"
    copy_chart "${chart_dir}" "${source_copy}"
    if prepare_dependencies "${source_copy}" "${stem}" &&
       run_step "${stem}: chart package validation" package_and_check "extra-${extra_index}" "${source_copy}"; then
        packaged+=("${chart_dir}")
        printf 'ok   package %s\n' "${stem}"
    else
        failed+=("${stem}")
    fi
done <"${package_work}/chart-roots"

echo
if [ "${#failed[@]}" -ne 0 ]; then
    printf 'check-helm-charts: %d chart checks failed: %s\n' \
        "${#failed[@]}" "${failed[*]}" >&2
    exit 1
fi

printf 'check-helm-charts: %d charts linted and rendered; %d chart packages validated\n' "${#stems[@]}" "${#packaged[@]}"
