set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

bad="$(find docs fern -type f \( -name '*.md' -o -name '*.mdx' \) -exec grep -nE '<img\b[^>]*[^/]>|<img>' {} \; || true)"
if [ -n "$bad" ]; then
  echo "Non-self-closing <img> tags found (MDX requires <img ... />):" >&2
  echo "$bad" >&2
  exit 1
fi

./tools/ci/check-doc-version-sync
./tools/ci/run-fern check
