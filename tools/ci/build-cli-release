set -euo pipefail

digest() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$@"
    else
        shasum -a 256 "$@"
    fi
}

# Usage: build-cli-release SOURCE_CHECKOUT RELEASE_TAG OUTPUT_DIRECTORY
# This helper does not publish. The source checkout must be the exact tag.
if [[ $# != 3 ]]; then
    echo "usage: build-cli-release SOURCE_CHECKOUT RELEASE_TAG OUTPUT_DIRECTORY" >&2
    exit 1
fi
source_dir=$(cd "$1" && pwd)
tag=$2
output_dir=$3
if [[ ! "$tag" =~ ^src/clis/nvcf-cli/v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$ ]]; then
    echo "expected a stable or RC src/clis/nvcf-cli/vX.Y.Z release tag" >&2
    exit 1
fi
version=${tag#src/clis/nvcf-cli/v}
cd "$source_dir"
commit=$(git rev-parse --verify "refs/tags/$tag^{commit}")
if [[ $(git rev-parse HEAD) != "$commit" ]] || [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
    echo "build requires a clean checkout at $tag ($commit)" >&2
    exit 1
fi
# Refuse to mix a new build with any existing artifacts.
mkdir "$output_dir"
output_dir=$(cd "$output_dir" && pwd)
staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT
export NVCF_VERSION="$version" NVCF_BUILD_USER=release
bazel build --stamp //src/clis/nvcf-cli:dist
if [[ $(git rev-parse HEAD) != "$commit" ]] || [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
    echo "source checkout changed during the build" >&2
    exit 1
fi
for platform in linux-amd64 linux-arm64 darwin-amd64 darwin-arm64 windows-amd64; do
    binary=$(bazel cquery --stamp "//src/clis/nvcf-cli:nvcf-cli-$platform" --output=files)
    if [[ "$binary" == *$'\n'* || ! -s "$binary" ]]; then
        echo "expected one nonempty binary for $platform" >&2
        exit 1
    fi
    package="$staging/$platform"
    mkdir "$package"
    name=nvcf-cli
    [[ "$platform" != windows-* ]] || name=nvcf-cli.exe
    install -m 0755 "$binary" "$package/$name"
    cp LICENSE NOTICE "$package/"
    printf 'tag=%s\ncommit=%s\nplatform=%s\n' "$tag" "$commit" "$platform" > "$package/SOURCE.txt"
    tar -czf "$output_dir/nvcf-cli-$version-$platform.tar.gz" -C "$package" .
done
# Write the completion marker only after every platform archive exists.
cd "$output_dir"
digest ./*.tar.gz > SHA256SUMS.tmp
digest -c SHA256SUMS.tmp
mv SHA256SUMS.tmp SHA256SUMS
