#
# Behavioral test for tools/ci/check-go-vendored-lib.
#
# Each case builds a small fake repository with a source library, one module
# that vendors it through a local replace, and one module that vendors a pinned
# version, then checks the guard tells drift apart from a clean tree.
set -euo pipefail

script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/check-go-vendored-lib"
lib_import="github.com/NVIDIA/nvcf/src/libraries/go/lib"
fail=0

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

fixture() {  # fixture: rebuild a clean fake repository at ${root}
    root="${work}/repo"
    rm -rf "${root}"
    local lib="${root}/src/libraries/go/lib"
    mkdir -p "${lib}/pkg/a/templates" "${lib}/pkg/unvendored"
    printf 'package a\n\nconst CPU = "1000m"\n' > "${lib}/pkg/a/a.go"
    printf 'package a\n' > "${lib}/pkg/a/a_test.go"
    printf 'key: value\n' > "${lib}/pkg/a/templates/t.yaml.tmpl"
    printf 'package unvendored\n' > "${lib}/pkg/unvendored/u.go"

    local mod="${root}/src/svc/local"
    local vend="${mod}/vendor/${lib_import}"
    mkdir -p "${vend}/pkg/a/templates"
    printf '# %s v0.0.0-00010101000000-000000000000 => ../../libraries/go/lib\n## explicit\n%s/pkg/a\n# %s => ../../libraries/go/lib\n' \
        "${lib_import}" "${lib_import}" "${lib_import}" > "${mod}/vendor/modules.txt"
    cp "${lib}/pkg/a/a.go" "${vend}/pkg/a/a.go"
    cp "${lib}/pkg/a/templates/t.yaml.tmpl" "${vend}/pkg/a/templates/t.yaml.tmpl"
    printf 'go_library(name = "a")\n' > "${vend}/pkg/a/BUILD.bazel"

    local pinned="${root}/src/svc/pinned"
    mkdir -p "${pinned}/vendor/${lib_import}/pkg/a"
    printf '# %s v0.0.0-20260101000000-0123456789ab\n## explicit\n%s/pkg/a\n' \
        "${lib_import}" "${lib_import}" > "${pinned}/vendor/modules.txt"
    printf 'package a\n\nconst CPU = "500m"\n' > "${pinned}/vendor/${lib_import}/pkg/a/a.go"
}

run() {
    set +e
    out="$(REPO_ROOT="${root}" bash "${script}" 2>&1)"
    rc=$?
    set -e
}

expect() {  # expect <desc> <want-rc> [substring]
    local desc="$1" want="$2" substr="${3:-}"
    if [ "${rc}" != "${want}" ]; then
        printf 'FAIL %s: want exit %s, got %s\n%s\n' "${desc}" "${want}" "${rc}" "${out}"
        fail=1; return
    fi
    if [ -n "${substr}" ] && ! grep -Fq -- "${substr}" <<<"${out}"; then
        printf 'FAIL %s: output missing %q\n%s\n' "${desc}" "${substr}" "${out}"
        fail=1; return
    fi
    printf 'ok   %s\n' "${desc}"
}

lib="src/libraries/go/lib"
vend="src/svc/local/vendor/${lib_import}"

fixture; run
expect "clean tree exits 0" 0 "match the source (1 module(s))"
expect "  ... and skips the pinned module" 0 "skip  src/svc/pinned: vendors a pinned library version"

fixture
printf 'package a\n\nconst CPU = "500m"\n' > "${root}/${vend}/pkg/a/a.go"
run
expect "stale vendored Go file exits 1" 1 "vendor/${lib_import}/pkg/a/a.go differs"
expect "  ... and shows the diff" 1 '+const CPU = "1000m"'

fixture
printf 'key: other\n' > "${root}/${lib}/pkg/a/templates/t.yaml.tmpl"
run
expect "stale vendored embedded file exits 1" 1 "pkg/a/templates/t.yaml.tmpl differs"

fixture
printf 'package a\n' > "${root}/${lib}/pkg/a/b.go"
run
expect "Go file added to the source exits 1" 1 "${lib}/pkg/a/b.go is not vendored"

fixture
printf 'package a\n' > "${root}/${lib}/pkg/a/b_test.go"
run
expect "test file added to the source exits 0" 0 "match the source"

fixture
rm "${root}/${lib}/pkg/a/a.go"
run
expect "file removed from the source exits 1" 1 "pkg/a/a.go is not in ${lib}"

fixture
rm -rf "${root:?}/${vend}"
run
expect "missing vendored copy exits 1" 1 "is missing"

fixture
sed -i 's#=> ../../libraries/go/lib#=> ../../nowhere#' "${root}/src/svc/local/vendor/modules.txt"
run
expect "replace target that does not exist exits 1" 1 "replace target ../../nowhere does not exist"

fixture
rm -rf "${root}/src/svc/local"
run
expect "nothing to check exits 1" 1 "nothing was checked"

if [ "${fail}" -ne 0 ]; then
    exit 1
fi
echo "check-go-vendored-lib: all cases passed"
