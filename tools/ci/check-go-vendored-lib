#
# Fail when a Go module's vendored copy of src/libraries/go/lib differs from
# the source tree.
#
# A module that replaces the library with the in-tree path still compiles the
# copy under its vendor/ directory, so a library fix only ships once that
# module re-vendors. This compares the vendored files with the source directly
# rather than running `go mod vendor`, which would also delete the Gazelle
# BUILD.bazel files some vendor trees commit, and it needs no network.
#
# Only files the module actually vendors are checked: a change to a library
# package the module does not import never fails here.
#
# Modules whose vendor/modules.txt shows a pinned library version instead of a
# local replace are skipped: their copy is meant to track that version.
#
# Usage: tools/ci/check-go-vendored-lib
# REPO_ROOT overrides the repository root, for tests.
set -euo pipefail
shopt -s nullglob dotglob

repo_root="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
lib_import="github.com/NVIDIA/nvcf/src/libraries/go/lib"
lib_rel="src/libraries/go/lib"
lib_dir="${repo_root}/${lib_rel}"

if [[ ! -d "${lib_dir}" ]]; then
    echo "missing ${lib_rel} under ${repo_root}" >&2
    exit 1
fi
lib_real="$(cd "${lib_dir}" && pwd -P)"

checked=0
drifted=()

report() {  # report <module-rel> <message>
    printf 'DRIFT %s: %s\n' "$1" "$2"
    if [[ ${#drifted[@]} -eq 0 || "${drifted[${#drifted[@]} - 1]}" != "$1" ]]; then
        drifted+=("$1")
    fi
}

# Succeed when go mod vendor leaves a Go file out because of its build
# constraint. Like cmd/go, treat every tag except ignore as both set and unset,
# so only a constraint that needs the ignore tag excludes the file.
go_build_excluded() {  # go_build_excluded <go-file>
    awk '
        function p_or(prefer,   v, r) {
            v = p_and(prefer)
            while (tok[pos] == "||") { pos++; r = p_and(prefer); v = v || r }
            return v
        }
        function p_and(prefer,   v, r) {
            v = p_unary(prefer)
            while (tok[pos] == "&&") { pos++; r = p_unary(prefer); v = v && r }
            return v
        }
        function p_unary(prefer,   t, v) {
            t = tok[pos++]
            if (t == "!") return !p_unary(!prefer)
            if (t == "(") {
                v = p_or(prefer)
                if (tok[pos++] != ")") bad = 1
                return v
            }
            if (t == "ignore") return 0
            if (t ~ /^[A-Za-z0-9_.]+$/) return prefer
            bad = 1
            return 0
        }
        function legacy(line,   n, terms, i, out) {
            n = split(line, terms, " ")
            out = ""
            for (i = 1; i <= n; i++) {
                gsub(/,/, " \\&\\& ", terms[i])
                out = out (out == "" ? "" : " || ") "(" terms[i] ")"
            }
            return "(" out ")"
        }
        /^package[ \t]/ { exit }
        /^\/\/go:build[ \t]/ { expr = substr($0, 11); exit }
        /^\/\/ \+build[ \t]/ {
            plus = plus (plus == "" ? "" : " && ") legacy(substr($0, 10))
        }
        END {
            if (expr == "") expr = plus
            if (expr == "") exit 1
            gsub(/\(|\)|!|&&|\|\|/, " & ", expr)
            n = split(expr, tok, " ")
            pos = 1
            v = p_or(1)
            if (pos <= n) bad = 1
            exit (bad || !v) ? 0 : 1
        }' "$1"
}

# go mod vendor copies every regular file of a vendored package directory
# except tests, go.mod, go.sum and Go files whose build constraint excludes
# them.
vendorable() {  # vendorable <source-file>
    local name="${1##*/}"
    case "${name}" in
        *_test.go | go.mod | go.sum | BUILD.bazel | BUILD) return 1 ;;
        *.go) ! go_build_excluded "$1" ;;
        *) return 0 ;;
    esac
}

check_module() {  # check_module <module-dir>
    local module_dir="$1" rel target packages resolved vendored f r d src
    rel="${module_dir#"${repo_root}/"}"

    # The library's header line in modules.txt is
    #   # <import path> [version] [=> <replacement> [version]]
    # followed by the vendored package paths. Print the replacement, if any,
    # and the number of vendored packages.
    read -r target packages < <(awk -v m="${lib_import}" '
        found && /^# / { exit }
        found && !/^#/ { packages++ }
        !found && $1 == "#" && $2 == m {
            found = 1
            for (i = 3; i <= NF; i++) if ($i == "=>") target = $(i + 1)
        }
        END { print (target == "" ? "-" : target), packages + 0 }
    ' "${module_dir}/vendor/modules.txt")
    [[ "${target}" == "-" ]] && target=""

    if [[ -z "${target}" ]]; then
        if grep -Fq "# ${lib_import} " "${module_dir}/vendor/modules.txt"; then
            echo "skip  ${rel}: vendors a pinned library version"
        fi
        return 0
    fi
    case "${target}" in
        ./* | ../* | /*) ;;
        *)
            echo "skip  ${rel}: replaces the library with module ${target}"
            return 0
            ;;
    esac
    if ! resolved="$(cd "${module_dir}" && cd "${target}" 2>/dev/null && pwd -P)"; then
        report "${rel}" "replace target ${target} does not exist"
        return 0
    fi
    if [[ "${resolved}" != "${lib_real}" ]]; then
        echo "skip  ${rel}: replaces the library with ${target}"
        return 0
    fi

    if [[ "${packages}" -eq 0 ]]; then
        echo "skip  ${rel}: vendors none of the library's packages"
        return 0
    fi

    vendored="${module_dir}/vendor/${lib_import}"
    if [[ ! -d "${vendored}" ]]; then
        report "${rel}" "vendor/modules.txt lists the library but vendor/${lib_import} is missing"
        return 0
    fi
    checked=$((checked + 1))

    # Every vendored file must still exist in the source with the same bytes.
    # BUILD.bazel files are generated per vendor tree by Gazelle.
    while IFS= read -r -d '' f; do
        r="${f#"${vendored}/"}"
        if [[ ! -f "${lib_dir}/${r}" ]]; then
            report "${rel}" "vendor/${lib_import}/${r} is not in ${lib_rel}"
        elif ! cmp -s "${f}" "${lib_dir}/${r}"; then
            report "${rel}" "vendor/${lib_import}/${r} differs from ${lib_rel}/${r}"
            diff -u --label "vendored/${r}" --label "${lib_rel}/${r}" \
                "${f}" "${lib_dir}/${r}" | head -n 40 || true
        fi
    done < <(find "${vendored}" -type f ! -name BUILD.bazel -print0 | sort -z)

    # Every file go mod vendor would copy into a vendored package directory
    # must be there, so a file added to the source is caught too.
    while IFS= read -r -d '' d; do
        if ! compgen -G "${d}/*.go" >/dev/null; then
            continue
        fi
        r="${d#"${vendored}"}"
        for src in "${lib_dir}${r}"/*; do
            [[ -f "${src}" ]] || continue
            vendorable "${src}" || continue
            if [[ ! -f "${d}/${src##*/}" ]]; then
                report "${rel}" "${lib_rel}${r}/${src##*/} is not vendored"
            fi
        done
    done < <(find "${vendored}" -type d -print0 | sort -z)
}

while IFS= read -r -d '' modules_txt; do
    check_module "${modules_txt%/vendor/modules.txt}"
done < <(find "${repo_root}" \( -name .git -o -name node_modules \) -prune -o \
    -path '*/vendor/modules.txt' ! -path '*/vendor/*/vendor/*' -print0 | sort -z)

if [[ ${#drifted[@]} -ne 0 ]]; then
    cat <<EOF

A vendored copy of ${lib_rel} is out of date. A change to ${lib_rel}
must re-vendor every module that compiles the changed files, in the same pull
request. From the repository root, run:
EOF
    for rel in "${drifted[@]}"; do
        cat <<EOF

  (cd ${rel} && GOWORK=off go mod vendor)
  git -C ${rel} checkout -- ':(glob)vendor/**/BUILD.bazel'
EOF
    done
    cat <<EOF

go mod vendor deletes or overwrites the Gazelle BUILD.bazel files committed
under vendor/, and the second command restores them. If go mod vendor asks for
go mod tidy, the library gained a dependency: run it and commit go.mod and
go.sum too. If a vendored file was added or removed, also update the srcs or
embedsrcs of that package's vendor BUILD.bazel. Then rerun
tools/ci/check-go-vendored-lib and commit the result.
EOF
    exit 1
fi

if [[ "${checked}" -eq 0 ]]; then
    echo "no module vendors ${lib_rel} through a local replace; nothing was checked" >&2
    exit 1
fi

echo "vendored copies of ${lib_rel} match the source (${checked} module(s))"
