# Canonical project view for the monorepo Java components.

derive_targets_from_directories: true
allow_manual_targets_sync: true

enabled_rules:
  rules_java

directories:
  src/libraries/java/nv-boot-parent
  src/control-plane-services/api-keys
  src/control-plane-services/cloud-functions
  src/control-plane-services/cloud-tasks
  src/control-plane-services/encrypted-secret-store
  src/control-plane-services/instance-cluster-management
  src/control-plane-services/notary
