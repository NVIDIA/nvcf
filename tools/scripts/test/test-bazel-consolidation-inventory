# Fixture tests for tools/ci/bazel-consolidation-inventory.
#
# The cases here are the ones that actually went wrong while the tool was being
# written: vendored trees leaking into first-party counts, root-level paths
# being missed by an unanchored pattern, and untracked files being measured
# under a commit stamp that does not contain them.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INVENTORY="${SCRIPT_DIR}/../../ci/bazel-consolidation-inventory"

TEMP_DIRS=()
FAILURES=0

cleanup() {
    local path
    for path in "${TEMP_DIRS[@]:-}"; do
        [ -n "${path}" ] && rm -rf "${path}"
    done
}
trap cleanup EXIT

# Sets TEMPDIR_OUT rather than echoing. Calling this through command
# substitution would run it in a subshell, so the TEMP_DIRS append would be
# discarded and the cleanup trap would have nothing to remove.
TEMPDIR_OUT=""
make_tempdir() {
    TEMPDIR_OUT="$(mktemp -d)"
    TEMP_DIRS+=("${TEMPDIR_OUT}")
}

fail() {
    echo "FAIL: $*" >&2
    FAILURES=$((FAILURES + 1))
}

pass() {
    echo "ok: $*"
}

# assert_line <output> <description> <expected-substring>
assert_line() {
    local output="$1" description="$2" expected="$3"
    if grep -qF -- "${expected}" <<<"${output}"; then
        pass "${description}"
    else
        fail "${description}: expected to find '${expected}' in:"
        sed 's/^/    /' <<<"${output}" >&2
    fi
}

# assert_absent <output> <description> <unexpected-substring>
assert_absent() {
    local output="$1" description="$2" unexpected="$3"
    if grep -qF -- "${unexpected}" <<<"${output}"; then
        fail "${description}: did not expect '${unexpected}' in output"
    else
        pass "${description}"
    fi
}

# Builds a fixture repository exercising every filter the tool applies.
build_fixture() {
    local root="$1"
    mkdir -p "${root}"
    git -C "${root}" init -q
    git -C "${root}" config user.email fixture@example.com
    git -C "${root}" config user.name Fixture

    # Root module plus a root-level rules/oci copy. The root-level copy is the
    # regression case: a '**/rules/oci/*' pattern silently misses it because
    # there is no leading path component.
    mkdir -p "${root}/rules/oci/private"
    printf 'module(name = "root")\n' >"${root}/MODULE.bazel"
    printf '{}\n' >"${root}/MODULE.bazel.lock"
    printf 'root oci defs\n' >"${root}/rules/oci/defs.bzl"
    printf 'root oci common\n' >"${root}/rules/oci/private/common.bzl"

    # One first-party service: pinned Bazel version, its own rules/oci copy,
    # one digest-pinned pull and one tag-only pull.
    mkdir -p "${root}/src/svc-a/rules/oci"
    printf 'module(name = "svc_a")\n' >"${root}/src/svc-a/MODULE.bazel"
    cat >>"${root}/src/svc-a/MODULE.bazel" <<'EOF'
go_sdk.download(version = "1.25.11")
oci.pull(
    name = "distroless_go",
    image = "nvcr.io/nvidia/distroless/go",
    digest = "sha256:aaaa",
)
oci.pull(
    name = "temurin",
    image = "public.ecr.aws/docker/library/eclipse-temurin",
    tag = "21-jre",
)
EOF
    printf '{}\n' >"${root}/src/svc-a/MODULE.bazel.lock"
    printf '8.6.0\n' >"${root}/src/svc-a/.bazelversion"
    printf 'build --config=x\n' >"${root}/src/svc-a/.bazelrc"
    printf 'svc-a oci defs\n' >"${root}/src/svc-a/rules/oci/defs.bzl"
    cat >"${root}/src/svc-a/BUILD.bazel" <<'EOF'
package(default_visibility = ["//:__subpackages__"])
go_library(name = "a", visibility = ["//visibility:public"])
EOF

    # A second service on a different Bazel version, sharing svc-a's .bazelrc
    # content so the distinct-content count must differ from the file count.
    mkdir -p "${root}/src/svc-b"
    printf 'module(name = "svc_b")\n' >"${root}/src/svc-b/MODULE.bazel"
    printf '9.1.1\n' >"${root}/src/svc-b/.bazelversion"
    printf 'build --config=x\n' >"${root}/src/svc-b/.bazelrc"
    printf 'go_library(name = "b")\n' >"${root}/src/svc-b/BUILD.bazel"

    # Vendored third-party tree. Everything below must be excluded from
    # first-party counts: an old Go SDK, a nested module, public visibility,
    # __subpackages__, and its own rules/oci copy.
    mkdir -p "${root}/src/svc-a/vendor/example.com/dep/rules/oci"
    cat >"${root}/src/svc-a/vendor/example.com/dep/MODULE.bazel" <<'EOF'
module(name = "vendored_dep")
go_sdk.download(version = "1.23.0")
oci.pull(
    name = "vendored_base",
    image = "docker.io/library/vendored",
    tag = "latest",
)
EOF
    cat >"${root}/src/svc-a/vendor/example.com/dep/BUILD.bazel" <<'EOF'
package(default_visibility = ["//:__subpackages__"])
go_library(name = "dep", visibility = ["//visibility:public"])
EOF
    printf 'vendored oci\n' \
        >"${root}/src/svc-a/vendor/example.com/dep/rules/oci/defs.bzl"

    git -C "${root}" add -A
    git -C "${root}" commit -qm "fixture"
}

echo "== fixture: vendor filtering and path anchoring =="
make_tempdir
FIXTURE="${TEMPDIR_OUT}/repo"
build_fixture "${FIXTURE}"
OUT="$(cd "${FIXTURE}" && "${INVENTORY}" "${FIXTURE}")"

# Two first-party service modules; the vendored one must not be counted.
assert_line "${OUT}" "counts only first-party service modules" \
    "service modules (src, excluding vendor) : 2"
# Root + svc-a + svc-b + vendored dep.
assert_line "${OUT}" "counts every module including vendored" \
    "MODULE.bazel total (incl. root/helpers) : 4"

# svc-a and svc-b only.
assert_line "${OUT}" "excludes vendored .bazelrc" \
    "subtree .bazelrc                        : 2 (1 distinct)"
assert_line "${OUT}" "reports both Bazel versions" \
    "1 on 8.6.0  1 on 9.1.1"

# Root copy (2 files) + svc-a copy (1 file). The vendored copy is excluded.
# This fails if the root-level path is not matched by the pattern.
assert_line "${OUT}" "includes root-level rules/oci and excludes vendored" \
    "rules/oci copied files                  : 3 files"

# One occurrence each in svc-a; the vendored BUILD.bazel must not contribute.
assert_line "${OUT}" "excludes vendored __subpackages__" \
    "root-relative //:__subpackages__         : 1"
assert_line "${OUT}" "excludes vendored public visibility" \
    "//visibility:public (outside vendor)    : 1"
assert_line "${OUT}" "reports zero package_group" \
    "package_group definitions               : 0"

echo
echo "== fixture: Go SDK provenance is separated =="
assert_line "${OUT}" "first-party Go SDK excludes the vendored 1.23.0" \
    "go_sdk.download (first-party)           : 1.25.11"
assert_line "${OUT}" "vendored-inclusive Go SDK shows 1.23.0" \
    "go_sdk.download (incl. vendored)        : 1.23.0 1.25.11"

echo
echo "== fixture: OCI pull parsing =="
# Two first-party pulls; the vendored pull is excluded.
assert_line "${OUT}" "counts first-party oci.pull declarations" \
    "oci.pull declarations                   : 2 (1 from nvcr.io)"
assert_line "${OUT}" "separates distinct images from digests" \
    "oci.pull distinct images / digests      : 2 images, 1 digests"
assert_line "${OUT}" "identifies the tag-only pull by name" \
    "oci.pull without a digest (tag-only)    : 1 (public.ecr.aws/docker/library/eclipse-temurin)"
assert_absent "${OUT}" "vendored pull is not reported as tag-only" \
    "docker.io/library/vendored"

echo
echo "== fixture: untracked files are not measured =="
# Paths come from git, so an untracked module must never be counted. The tool
# refuses to run on a dirty tree at all, so this case has to opt in explicitly.
mkdir -p "${FIXTURE}/src/svc-c"
printf 'module(name = "untracked")\n' >"${FIXTURE}/src/svc-c/MODULE.bazel"

if (cd "${FIXTURE}" && "${INVENTORY}" "${FIXTURE}") >/dev/null 2>&1; then
    fail "expected a non-zero exit status with an untracked file present"
else
    pass "untracked file alone makes the tree dirty and is rejected"
fi

OUT_DIRTY="$(cd "${FIXTURE}" && "${INVENTORY}" --allow-dirty "${FIXTURE}")"
assert_line "${OUT_DIRTY}" "untracked module is excluded from the count" \
    "service modules (src, excluding vendor) : 2"
assert_line "${OUT_DIRTY}" "stamp says working tree rather than the commit" \
    "(WORKING TREE, not"
rm -rf "${FIXTURE}/src/svc-c"

echo
echo "== fixture: a modified tracked file is rejected =="
# The untracked case above is not sufficient. Contents are read from the working
# tree, so an edit to a TRACKED file changes measurements while the stamp still
# names HEAD. That must fail rather than silently misreport.
git -C "${FIXTURE}" checkout -q -- . 2>/dev/null || true
rm -rf "${FIXTURE}/src/svc-c"
printf '\ngo_library(name = "extra", visibility = ["//visibility:public"])\n' \
    >>"${FIXTURE}/src/svc-b/BUILD.bazel"
if OUT_MOD="$(cd "${FIXTURE}" && "${INVENTORY}" "${FIXTURE}" 2>&1)"; then
    fail "expected a non-zero exit status when a tracked file is modified"
else
    pass "modified tracked file is rejected"
fi
assert_line "${OUT_MOD}" "rejection names the offending commit" "working tree is dirty"

OUT_ALLOW="$(cd "${FIXTURE}" && "${INVENTORY}" --allow-dirty "${FIXTURE}")"
assert_line "${OUT_ALLOW}" "--allow-dirty stamps the working tree, not HEAD" \
    "(WORKING TREE, not"
# The injected line must actually be counted, proving the override reads the
# working tree rather than silently reusing a cached HEAD measurement.
assert_line "${OUT_ALLOW}" "--allow-dirty picks up the uncommitted occurrence" \
    "//visibility:public (outside vendor)    : 2"
git -C "${FIXTURE}" checkout -q -- .

echo
echo "== fixture: a missing tracked file must not silently lower a count =="
# The regression this guards: the three visibility counts appended `|| true` to
# the whole pipeline, so a failure to read the files became a silent zero rather
# than an error. --allow-dirty must not rescue that.
rm "${FIXTURE}/src/svc-a/BUILD.bazel"
if OUT_GONE="$(cd "${FIXTURE}" && "${INVENTORY}" --allow-dirty "${FIXTURE}" 2>&1)"; then
    fail "expected failure when a tracked BUILD.bazel is missing, got:"
    sed 's/^/    /' <<<"${OUT_GONE}" >&2
else
    pass "missing tracked BUILD.bazel is an error, not a lower count"
fi
assert_line "${OUT_GONE}" "the missing file is named" "src/svc-a/BUILD.bazel"
git -C "${FIXTURE}" checkout -q -- .

echo
echo "== fixture: count_occurrences failure is not masked =="
# The missing-file case above is caught by the preflight. This one gets past it:
# a tracked symlink pointing at a directory is readable, so -r succeeds, but cat
# fails with "Is a directory". That exercises count_occurrences itself, which is
# where the `|| true` masking lived.
mkdir -p "${FIXTURE}/src/svc-d"
ln -s .. "${FIXTURE}/src/svc-d/BUILD.bazel"
git -C "${FIXTURE}" add -A
git -C "${FIXTURE}" commit -qm "symlinked BUILD.bazel"
if OUT_SYM="$(cd "${FIXTURE}" && "${INVENTORY}" "${FIXTURE}" 2>&1)"; then
    fail "expected failure when a tracked BUILD.bazel cannot be read, got:"
    sed 's/^/    /' <<<"${OUT_SYM}" >&2
else
    pass "unreadable tracked BUILD.bazel fails instead of counting zero"
fi
git -C "${FIXTURE}" reset -q --hard HEAD~1
rm -rf "${FIXTURE}/src/svc-d"

echo
echo "== injected git failures must not produce a report =="
# git status failing looked exactly like a clean tree, and git ls-files failing
# inside a pipeline produced an empty file list that every count read as zero.
FAKEBIN="${TEMPDIR_OUT}/fakebin"
mkdir -p "${FAKEBIN}"
for broken in status ls-files; do
    cat >"${FAKEBIN}/git" <<EOF
#!/bin/bash
[ "\$1" = "${broken}" ] && exit 7
exec $(command -v git) "\$@"
EOF
    chmod +x "${FAKEBIN}/git"
    if OUT_GIT="$(cd "${FIXTURE}" && PATH="${FAKEBIN}:${PATH}" "${INVENTORY}" "${FIXTURE}" 2>&1)"; then
        fail "expected failure when 'git ${broken}' fails, got:"
        sed 's/^/    /' <<<"${OUT_GIT}" >&2
    else
        pass "'git ${broken}' failure is an error, not a report"
    fi
    assert_absent "${OUT_GIT}" "no measurements printed when 'git ${broken}' fails" \
        "service modules (src, excluding vendor)"
done
rm -rf "${FAKEBIN}"

echo
echo "== failure propagation =="
# The tool must not report success when a measurement cannot be taken. Running
# outside a git repository is the cheapest way to force that.
make_tempdir
NOT_A_REPO="${TEMPDIR_OUT}/plain"
mkdir -p "${NOT_A_REPO}"
if (cd "${NOT_A_REPO}" && "${INVENTORY}" "${NOT_A_REPO}") >/dev/null 2>&1; then
    fail "expected a non-zero exit status outside a git repository"
else
    pass "non-zero exit status outside a git repository"
fi

echo
if [ "${FAILURES}" -ne 0 ]; then
    echo "${FAILURES} test(s) failed" >&2
    exit 1
fi
echo "all tests passed"
