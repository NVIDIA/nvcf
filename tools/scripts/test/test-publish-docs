set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
mkdir -p "$workdir/source/tools/ci" "$workdir/bin"
cp "$repo_root/tools/ci/publish-docs" "$workdir/source/tools/ci/"
export FIXTURE_ROOT="$workdir/source" FIXTURE_LOG="$workdir/log" DOCS_VERSION_SYNC_BIN="$workdir/bin/sync"
cat > "$DOCS_VERSION_SYNC_BIN" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$2" == docs-mode ]]; then echo "${FIXTURE_MODE:-legacy}"; exit; fi
[[ "$2" == docs-stage ]]
if [[ "${FAIL_STAGE:-0}" != 0 ]]; then exit 17; fi
mkdir -p "$6"
printf 'approved\n' > "$6/content"
printf '{}\n' > "$6/docs-build-receipt.json"
SH
cat > "$workdir/source/tools/ci/check-docs" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ "$PWD" == "$FIXTURE_ROOT" ]]
echo legacy-check >> "$FIXTURE_LOG"
exit "${FAIL_CHECK:-0}"
SH
cat > "$workdir/source/tools/ci/check-doc-version-sync" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ "$PWD" == "$FIXTURE_ROOT" ]]
echo catalog-check >> "$FIXTURE_LOG"
SH
cat > "$workdir/source/tools/ci/run-fern" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${FIXTURE_MODE:-legacy}" == umbrella ]]; then
  [[ "$PWD" != "$FIXTURE_ROOT" ]]
  [[ "$(cat content)" == approved ]]
  # Simulate an advancing source branch after validation. Generation must use its staged copy.
  printf 'unapproved\n' > "$FIXTURE_ROOT/content"
fi
echo "$1" >> "$FIXTURE_LOG"
if [[ "$1" == check ]]; then exit "${FAIL_CHECK:-0}"; fi
[[ "$*" == 'generate --docs --strict-broken-links' ]]
SH
chmod +x "$workdir/source/tools/ci/"* "$DOCS_VERSION_SYNC_BIN"
mkdir -p "$FIXTURE_ROOT/docs" "$FIXTURE_ROOT/fern"
printf 'reviewed docs\n' > "$FIXTURE_ROOT/docs/page.md"
printf 'reviewed config\n' > "$FIXTURE_ROOT/fern/docs.yml"
printf 'ignored.md\n' > "$FIXTURE_ROOT/.gitignore"
git -C "$FIXTURE_ROOT" init --quiet
git -C "$FIXTURE_ROOT" add .
git -C "$FIXTURE_ROOT" -c user.name=Test -c user.email=test@example.com commit --quiet -m fixture
: > "$FIXTURE_LOG"
"$workdir/source/tools/ci/publish-docs" --publish
[[ "$(cat "$FIXTURE_LOG")" == $'legacy-check\ngenerate' ]]
: > "$FIXTURE_LOG"
FIXTURE_MODE=umbrella "$workdir/source/tools/ci/publish-docs" --publish
[[ "$(cat "$FIXTURE_LOG")" == $'catalog-check\ncheck\ngenerate' ]]
for failure in FAIL_CHECK FAIL_STAGE; do
  : > "$FIXTURE_LOG"
  if env FIXTURE_MODE=umbrella "$failure"=17 "$workdir/source/tools/ci/publish-docs" --publish; then
    echo "expected publisher failure"; exit 1
  fi
  ! grep -q generate "$FIXTURE_LOG"
done
: > "$FIXTURE_LOG"
FIXTURE_MODE=umbrella "$workdir/source/tools/ci/publish-docs" --check
! grep -q generate "$FIXTURE_LOG"
for tree in docs fern; do
  for dirty in tracked staged untracked ignored; do
    case "$dirty" in
      tracked|staged)
        if [[ "$tree" == docs ]]; then path=docs/page.md; else path=fern/docs.yml; fi
        printf 'unreviewed edit\n' >> "$FIXTURE_ROOT/$path"
        if [[ "$dirty" == staged ]]; then git -C "$FIXTURE_ROOT" add "$path"; fi
        ;;
      untracked) printf 'untracked content\n' > "$FIXTURE_ROOT/$tree/new.md" ;;
      ignored) printf 'ignored content\n' > "$FIXTURE_ROOT/$tree/ignored.md" ;;
    esac
    for mode in --check --publish; do
      : > "$FIXTURE_LOG"
      if FIXTURE_MODE=umbrella "$FIXTURE_ROOT/tools/ci/publish-docs" "$mode" > "$workdir/dirty.log" 2>&1; then
        echo "accepted $dirty $tree input in $mode"; exit 1
      fi
      grep -q 'requires a clean docs/ and fern/ tree' "$workdir/dirty.log"
      [[ ! -s "$FIXTURE_LOG" ]]
    done
    git -C "$FIXTURE_ROOT" restore --source=HEAD --staged --worktree -- docs fern
    rm -f "$FIXTURE_ROOT/$tree/new.md" "$FIXTURE_ROOT/$tree/ignored.md"
  done
done
# The opt-in guard does not alter the legacy publisher's working-tree behavior.
printf 'legacy edit\n' >> "$FIXTURE_ROOT/docs/page.md"
: > "$FIXTURE_LOG"
"$FIXTURE_ROOT/tools/ci/publish-docs" --publish
[[ "$(cat "$FIXTURE_LOG")" == $'legacy-check\ngenerate' ]]
echo 'test-publish-docs: PASS'
