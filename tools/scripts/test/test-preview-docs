set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
mkdir -p "$workdir/bin" "$workdir/source/tools/ci" "$workdir/source/fern" "$workdir/source/docs"
cp "$repo_root/tools/ci/preview-docs" "$workdir/source/tools/ci/preview-docs"
printf 'legacy\n' > "$workdir/source/fern/docs.yml"
printf 'candidate\n' > "$workdir/source/fern/candidate.yml"
printf 'source content\n' > "$workdir/source/docs/page.md"
cat > "$workdir/source/tools/ci/run-fern" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [ -n "${EXPECT_CANDIDATE:-}" ]; then
  [ "$(cat fern/docs.yml)" = candidate ]
  [ "$(cat docs/page.md)" = 'uncommitted candidate content' ]
  [ "$(git remote get-url origin)" = 'https://github.com/example/docs.git' ]
  [ "$(git rev-parse HEAD)" = "$EXPECT_SHA" ]
fi
if [ "${OMIT_URL:-0}" != 1 ]; then
  echo 'Published docs to https://nvidia-preview-nvcf-test.docs.buildwithfern.com/nvcf (preview)'
fi
exit "${TEST_FERN_EXIT:-0}"
SH
cat > "$workdir/bin/curl" <<'SH'
#!/usr/bin/env bash
exit 22
SH
chmod +x "$workdir/source/tools/ci/"* "$workdir/bin/curl"
cd "$workdir/source"
git init --quiet
git -c user.name=Test -c user.email=test@example.com add .
git -c user.name=Test -c user.email=test@example.com commit --quiet -m fixture
git remote add origin https://github.com/example/docs.git
export PATH="$workdir/bin:$PATH"
export DOCS_PREVIEW_ID=nvcf-test
CI_MERGE_REQUEST_IID=320 CI_MERGE_REQUEST_PROJECT_ID=123 \
  CI_API_V4_URL=https://example.com/api/v4 FERN_BOT=fake-token \
  tools/ci/preview-docs > "$workdir/comment.txt" 2>&1
grep -q 'Skipping MR comment: GitLab API request failed.' "$workdir/comment.txt"
status=0
TEST_FERN_EXIT=42 tools/ci/preview-docs > "$workdir/failure.txt" 2>&1 || status=$?
[ "$status" -eq 42 ] || { echo "Preview build failure was hidden: $status"; exit 1; }
if OMIT_URL=1 tools/ci/preview-docs > "$workdir/missing.txt" 2>&1; then
  echo 'expected missing preview URL to fail'; exit 1
fi
printf 'uncommitted candidate content\n' > docs/page.md
EXPECT_SHA="$(git rev-parse HEAD)"
export EXPECT_SHA
EXPECT_CANDIDATE=1 DOCS_PREVIEW_CONFIG=fern/candidate.yml DOCS_PREVIEW_SKIP_COMMENT=1 \
  tools/ci/preview-docs > "$workdir/candidate.txt" 2>&1
[ "$(cat fern/docs.yml)" = legacy ]
[ "$(cat docs/page.md)" = 'uncommitted candidate content' ]
if DOCS_PREVIEW_CONFIG=fern/../outside.yml tools/ci/preview-docs > "$workdir/invalid.txt" 2>&1; then
  echo 'expected an invalid candidate path to fail'; exit 1
fi
echo 'test-preview-docs: PASS'
